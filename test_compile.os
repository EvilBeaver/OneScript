// Тестовый скрипт для проверки компиляции
Перем Счётчик;

Процедура ПриветМир()
    Сообщить("Привет, мир!");
КонецПроцедуры

Функция Сложить(А, Б)
    Возврат А + Б;
КонецФункции

Счётчик = 0;
Для Индекс = 1 По 5 Цикл
    Счётчик = Счётчик + Индекс;
КонецЦикла;

ПриветМир();
Сообщить("Сумма от 1 до 5: " + Счётчик);
Сообщить("2 + 3 = " + Сложить(2, 3));
