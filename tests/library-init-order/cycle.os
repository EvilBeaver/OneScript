#Использовать "cycle"

Функция Результат() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЗначениеВ", ПорядокИнициализацииВ.Значение);
	Результат.Вставить("ЗначениеГ", ПорядокИнициализацииГ.Значение);
	Результат.Вставить("СоседВ", ПорядокИнициализацииВ.ЗначениеСоседа);
	Результат.Вставить("СоседГ", ПорядокИнициализацииГ.ЗначениеСоседа);
	Возврат Результат;

КонецФункции
