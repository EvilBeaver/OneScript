#Использовать "order"

Функция Результат() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИзТела", ПорядокИнициализацииА.ИзТела);
	Результат.Вставить("ЧерезВычислить", ПорядокИнициализацииА.ЧерезВычислить);
	Результат.Вставить("ЧерезМетод", ПорядокИнициализацииА.ЧерезМетод);
	Результат.Вставить("ЧислоЗапусков", ПорядокИнициализацииБ.ЧислоЗапусков);
	Возврат Результат;

КонецФункции
