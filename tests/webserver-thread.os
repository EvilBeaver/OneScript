///////////////////////////////////////////////////////////////////////
//
// Поток исполнения при обработке запросов веб-сервером.
//
// Каждый запрос обслуживается собственным потоком исполнения. Проверяется, что обработчик
// исключений работает в потоке упавшего обработчика запроса и видит его данные, а по окончании
// обработки запроса поток завершается с вызовом ПриЗавершении.
//
///////////////////////////////////////////////////////////////////////

Перем юТест;

// Число - Порт тестового веб-сервера.
Перем ПортТестовогоСервера;
// Число - Сколько раз сработал обработчик завершения потока запроса.
Перем ЗавершенийЗафиксировано;
// ВебСервер - Тестовый сервер. Виден фоновому заданию, которое его поднимает.
Перем Сервер;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ОбработатьИсключениеВПотокеЗапросаИЗавершитьЕго");

	Возврат ВсеТесты;

КонецФункции

// Обработчик завершения потока запроса.
//
Процедура ПриЗавершенииПотокаЗапроса() Экспорт
	ЗавершенийЗафиксировано = ЗавершенийЗафиксировано + 1;
КонецПроцедуры

Процедура ОбработчикЗапроса(Контекст, СледующийОбработчик) Экспорт

	Если Контекст.Запрос.Путь = "/ping" Тогда
		Контекст.Ответ.Записать("pong");
		Возврат;
	КонецЕсли;

	ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ЭтотОбъект.ПриЗавершенииПотокаЗапроса;

	ТекущийПоток().Данные.Вставить("метка", "метка-" + Контекст.ИдентификаторТрассировки);

	ВызватьИсключение "Падаем намеренно";

КонецПроцедуры

Процедура ОбработчикИсключений(Контекст) Экспорт

	Контекст.Ответ.КодСостояния = 500;
	// Значение положил обработчик запроса. Виден оно здесь только если обработчик исключений
	// работает в том же потоке исполнения.
	Контекст.Ответ.Записать("" + ТекущийПоток().Данные.Получить("метка"));

КонецПроцедуры

Процедура Вебсервер() Экспорт

	Сервер = Новый ВебСервер(ПортТестовогоСервера);
	Сервер.ДобавитьОбработчикЗапросов(ЭтотОбъект, "ОбработчикЗапроса");
	Сервер.ДобавитьОбработчикИсключений(ЭтотОбъект, "ОбработчикИсключений");
	Сервер.Запустить();

КонецПроцедуры

// Дожидается готовности сервера опросом, а не фиксированной паузой: на нагруженной машине
// подъём занимает непредсказуемое время, и пауза наугад делает тест нестабильным.
//
Функция ДождатьсяГотовностиСервера(Знач Соединение, Знач ПределОжидания = 30000)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < ПределОжидания Цикл
		Попытка
			Ответ = Соединение.Получить(Новый HTTPЗапрос("/ping"));
			Если Ответ.КодСостояния = 200 Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
			// Сервер ещё не поднялся - пробуем снова
		КонецПопытки;
		Приостановить(50);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Дожидается, пока обработчик завершения потока отработает: область сервисов запроса
// освобождается уже после отправки ответа, поэтому счётчик растёт чуть позже ответа.
//
Функция ДождатьсяЗавершенийПотоков(Знач Ожидается, Знач ПределОжидания = 30000)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < ПределОжидания Цикл
		Если ЗавершенийЗафиксировано >= Ожидается Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(50);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ТестДолжен_ОбработатьИсключениеВПотокеЗапросаИЗавершитьЕго() Экспорт

	ПортТестовогоСервера = 8182;
	ЗавершенийЗафиксировано = 0;

	МенеджерФоновыхЗаданий = Новый МенеджерФоновыхЗаданий;
	МенеджерФоновыхЗаданий.Выполнить(ЭтотОбъект, "Вебсервер");

	Попытка

		Соединение = Новый HTTPСоединение("http://127.0.0.1:" + ПортТестовогоСервера);

		юТест.ПроверитьРавенство(Истина, ДождатьсяГотовностиСервера(Соединение),
			"Тестовый веб-сервер должен подняться");

		// Проверки готовности тоже создают потоки исполнения - считаем только целевой запрос
		ЗавершенийЗафиксировано = 0;

		Ответ = Соединение.Получить(Новый HTTPЗапрос("/"));

		юТест.ПроверитьРавенство(500, Ответ.КодСостояния,
			"Обработчик исключений должен отработать");

		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		юТест.ПроверитьРавенство(Истина, СтрНачинаетсяС(ТелоОтвета, "метка-"),
			"Обработчик исключений должен видеть данные потока упавшего обработчика запроса,"
			+ " получено: " + ТелоОтвета);

		юТест.ПроверитьРавенство(Истина, ДождатьсяЗавершенийПотоков(1),
			"По окончании обработки запроса должен сработать обработчик ПриЗавершении");

	Исключение
		Сервер.Остановить();
		МенеджерФоновыхЗаданий.Очистить();
		ВызватьИсключение;
	КонецПопытки;

	Сервер.Остановить();
	МенеджерФоновыхЗаданий.Очистить();

КонецПроцедуры
