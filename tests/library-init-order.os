Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ИнициализироватьМодульБиблиотекиПриОбращенииИзТелаДругогоМодуля");
	ВсеТесты.Добавить("ТестДолжен_ОтдатьМодульБезИнициализацииПриКруговомОбращении");
	ВсеТесты.Добавить("ТестДолжен_ПрерватьЗагрузкуБиблиотекиПриОшибкеВТелеМодуля");
	ВсеТесты.Добавить("ТестДолжен_ПрерватьЗагрузкуБиблиотекиПриОшибкеМодуляПойманнойДругимМодулем");

	Возврат ВсеТесты;

КонецФункции

Функция ЗагрузитьФикстуру(Знач Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "library-init-order", Имя + ".os"));
КонецФункции

// https://github.com/EvilBeaver/OneScript/issues/1000
Процедура ТестДолжен_ИнициализироватьМодульБиблиотекиПриОбращенииИзТелаДругогоМодуля() Экспорт

	Результат = ЗагрузитьФикстуру("order").Результат();

	юТест.ПроверитьРавенство("значение Б", Результат.ИзТела, "Чтение переменной модуля");
	юТест.ПроверитьРавенство("значение Б", Результат.ЧерезВычислить, "Чтение через Вычислить");
	юТест.ПроверитьРавенство("значение Б", Результат.ЧерезМетод, "Вызов метода модуля");
	юТест.ПроверитьРавенство(1, Результат.ЧислоЗапусков, "Тело модуля выполняется один раз");

КонецПроцедуры

Процедура ТестДолжен_ОтдатьМодульБезИнициализацииПриКруговомОбращении() Экспорт

	Результат = ЗагрузитьФикстуру("cycle").Результат();

	юТест.ПроверитьРавенство("значение В", Результат.ЗначениеВ);
	юТест.ПроверитьРавенство("значение Г", Результат.ЗначениеГ);

	// В идет первым и видит Г, а Г, инициализированный из тела В, видит В еще без инициализации
	юТест.ПроверитьРавенство("значение Г", Результат.СоседВ);
	юТест.ПроверитьРавенство(Неопределено, Результат.СоседГ);

КонецПроцедуры

Процедура ТестДолжен_ПрерватьЗагрузкуБиблиотекиПриОшибкеВТелеМодуля() Экспорт

	Попытка
		ЗагрузитьФикстуру("error");
	Исключение
		юТест.ПроверитьВхождение(ОписаниеОшибки(), "Ошибка в теле модуля Е");
		Возврат;
	КонецПопытки;

	юТест.ТестПровален("Ошибка в теле модуля библиотеки должна прерывать загрузку");

КонецПроцедуры

Процедура ТестДолжен_ПрерватьЗагрузкуБиблиотекиПриОшибкеМодуляПойманнойДругимМодулем() Экспорт

	Попытка
		ЗагрузитьФикстуру("caught");
	Исключение
		юТест.ПроверитьВхождение(ОписаниеОшибки(), "Ошибка в теле модуля З");
		Возврат;
	КонецПопытки;

	юТест.ТестПровален("Ошибка в теле модуля библиотеки должна прерывать загрузку, даже если ее поймал другой модуль");

КонецПроцедуры
