Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоСтандартныйПотокВводаЭтоПоток");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьТаймаутЧтенияСтандартногоПотокВвода");
	#Если Не Linux Тогда
	// TODO: https://github.com/EvilBeaver/OneScript/issues/1255
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПередачуДанныхВСкриптЧерезСтандартныйПотокВвода");
	#КонецЕсли
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПеренаправлениеВывода");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПеренаправлениеВыводаВФоновыхЗаданиях");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоФоновоеЗаданиеНаследуетПотокВывода");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоСтрокиЗаданийНеСклеиваются");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПолучениеПотокаВывода");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПолучениеПотокаОшибок");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоЗаданиеПолучаетУнаследованныйПотокВывода");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьСменуКодировкиВыводаПослеПеренаправленияВЗадании");
	ВсеТесты.Добавить("ТестДолжен_ПроверитЦветКонсоли");

	Возврат ВсеТесты;

КонецФункции

Процедура ТестДолжен_ПроверитьЧтоСтандартныйПотокВводаЭтоПоток() Экспорт
	
	ПотокВвода = Консоль.ОткрытьСтандартныйПотокВвода();
	юТест.ПроверитьРавенство(Тип("Поток"), ТипЗнч(ПотокВвода), "Ошибка открытия стандартного потока ввода");

КонецПроцедуры

Процедура ТестДолжен_ПроверитьТаймаутЧтенияСтандартногоПотокВвода() Экспорт

	ПутьКОскрипт = ОбъединитьПути(КаталогПрограммы(), "oscript.dll");
	
	КодСкрипта = "ВходящийПоток = Консоль.ОткрытьСтандартныйПотокВвода();
	             |ВходящийПоток.ТаймаутЧтения = 100;
	             |Чтение = Новый ЧтениеТекста();
	             |Чтение.Открыть(ВходящийПоток);
	             |Попытка 
				 |	Сообщить(СокрЛП(Чтение.Прочитать()));
				 |Исключение
				 |	Сообщить(ИнформацияобОшибке().ПодробноеОписаниеОшибки());
				 |	ВызватьИсключение;
				 |КонецПопытки;";

	ТекстСкрипта = Новый ТекстовыйДокумент();
	ТекстСкрипта.УстановитьТекст(КодСкрипта);

	ВремФайл = ПолучитьИмяВременногоФайла("os");

	ТекстСкрипта.Записать(ВремФайл);

	ТестовыеДанные = "";

	ИсполняемаяКоманда = СтрШаблон("dotnet ""%1"" ""%2""", ПутьКОскрипт, ВремФайл);
	#Если Windows Тогда
		СтрокаЗапуска = СтрШаблон("cmd /c ""%1""", ИсполняемаяКоманда);
	#Иначе
		СтрокаЗапуска = СтрШаблон("sh -c '%1'", ИсполняемаяКоманда);
	#КонецЕсли
	Процесс = СоздатьПроцесс(СтрокаЗапуска, , Истина);
	Процесс.Запустить();

	// с запасом на запуск dotnet на нагруженном агенте, зависание все равно будет видно
	МаксимумОжидания = 10000;
	ИнтервалОжидания = 100;
	ВсегоОжидание = 0;
	Пока НЕ Процесс.Завершен Цикл
		Приостановить(ИнтервалОжидания);
		ВсегоОжидание = ВсегоОжидание + ИнтервалОжидания;
		Если ВсегоОжидание >= МаксимумОжидания Тогда
			Процесс.Завершить();
			юТест.ТестПровален("Ошибка чтения пустого стандартного потока ввода. Истекло время ожидания.");
		КонецЕсли;
	КонецЦикла;

	ВыводКоманды = СокрЛП(Процесс.ПотокВывода.Прочитать());
	
	УдалитьФайлы(ВремФайл);
	Сообщить(ВыводКоманды);
	юТест.ПроверитьРавенство(ВыводКоманды, ТестовыеДанные, "Ошибка чтения пустого стандартного потока ввода.");

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПередачуДанныхВСкриптЧерезСтандартныйПотокВвода() Экспорт

	ПутьКОскрипт = ОбъединитьПути(КаталогПрограммы(), "oscript.dll");
	
	КодСкрипта = "Чтение = Новый ЧтениеТекста();
	             |Чтение.Открыть(Консоль.ОткрытьСтандартныйПотокВвода());
	             |Сообщить(СокрЛП(Чтение.Прочитать()));
	             |";

	ТекстСкрипта = Новый ТекстовыйДокумент();
	ТекстСкрипта.УстановитьТекст(КодСкрипта);

	ВремФайл = ПолучитьИмяВременногоФайла("os");

	ТекстСкрипта.Записать(ВремФайл);

	ТестовыеДанные = "12346";

	ИсполняемаяКоманда = СтрШаблон("echo %1 | dotnet %2 %3", ТестовыеДанные, ПутьКОскрипт, ВремФайл);
	#Если Windows Тогда
		СтрокаЗапуска = СтрШаблон("cmd /c ""%1""", ИсполняемаяКоманда);
	#Иначе
		СтрокаЗапуска = СтрШаблон("sh -c '%1'", ИсполняемаяКоманда);
	#КонецЕсли

	Процесс = СоздатьПроцесс(СтрокаЗапуска, , Истина);
	Процесс.Запустить();

	Пока НЕ Процесс.Завершен Цикл
		Приостановить(100);
	КонецЦикла;

	ВыводКоманды = СокрЛП(Процесс.ПотокВывода.Прочитать());

	УдалитьФайлы(ВремФайл);

	юТест.ПроверитьРавенство(ВыводКоманды, ТестовыеДанные, "Ошибка чтения стандартного потока ввода.");

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПеренаправлениеВывода() Экспорт
	
	ВФ = ПолучитьИмяВременногоФайла();
	Поток = ФайловыеПотоки.ОткрытьДляЗаписи(ВФ);
	Консоль.УстановитьПотокВывода(Поток);
	Попытка
		Сообщить("Привет мир!");
	Исключение
		// что-то пошло не так
		Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());
		ВызватьИсключение;
	КонецПопытки;
	
	Поток.Закрыть();
	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());

	Чтение = Новый ЧтениеТекста(ВФ, Консоль.КодировкаВыходногоПотока);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	УдалитьФайлы(ВФ);

	юТест.ПроверитьРавенство("Привет мир!", СокрЛП(Текст));

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПеренаправлениеВыводаВФоновыхЗаданиях() Экспорт

	ВыводТеста = Новый ПотокВПамяти;
	ВыводЗаданий = Новый Массив;
	Задания = Новый Массив;

	Консоль.УстановитьПотокВывода(ВыводТеста);
	Попытка
		Для Номер = 1 По 8 Цикл
			ВыводЗадания = Новый ПотокВПамяти;
			ВыводЗаданий.Добавить(ВыводЗадания);
			Параметры = Новый Массив;
			Параметры.Добавить(ВыводЗадания);
			Параметры.Добавить("задание " + Номер);
			Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВывестиСтрокиВСвойПоток", Параметры));
		КонецЦикла;
		// Пока задания пишут в свои потоки
		ВывестиСтроки("тест");
		ФоновыеЗадания.ОжидатьВсе(Задания);
	Исключение
		Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());
		ВызватьИсключение;
	КонецПопытки;
	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());

	ПроверитьЧтоЗаданияБезОшибок(Задания);
	ПроверитьВыведенныеСтроки(ВыводТеста, "тест", КоличествоСтрокВывода());
	Для Номер = 1 По 8 Цикл
		ПроверитьВыведенныеСтроки(ВыводЗаданий[Номер - 1], "задание " + Номер, КоличествоСтрокВывода());
	КонецЦикла;

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоФоновоеЗаданиеНаследуетПотокВывода() Экспорт

	Вывод = Новый ПотокВПамяти;

	Консоль.УстановитьПотокВывода(Вывод);
	Попытка
		Параметры = Новый Массив;
		Параметры.Добавить("из задания");
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВывестиСтроки", Параметры);
		Задание.ОжидатьЗавершения();
	Исключение
		Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());
		ВызватьИсключение;
	КонецПопытки;
	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());

	ПроверитьЧтоЗаданияБезОшибок(МассивИз(Задание));
	ПроверитьВыведенныеСтроки(Вывод, "из задания", КоличествоСтрокВывода());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоСтрокиЗаданийНеСклеиваются() Экспорт

	Вывод = Новый ПотокВПамяти;
	Задания = Новый Массив;

	Консоль.УстановитьПотокВывода(Вывод);
	Попытка
		Для Номер = 1 По 8 Цикл
			Параметры = Новый Массив;
			Параметры.Добавить("задание");
			Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВывестиСтроки", Параметры));
		КонецЦикла;
		ФоновыеЗадания.ОжидатьВсе(Задания);
	Исключение
		Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());
		ВызватьИсключение;
	КонецПопытки;
	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());

	ПроверитьЧтоЗаданияБезОшибок(Задания);
	ПроверитьВыведенныеСтроки(Вывод, "задание", 8 * КоличествоСтрокВывода());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПолучениеПотокаВывода() Экспорт

	Прежний = Консоль.ПолучитьПотокВывода();
	Лог = Новый ПотокВПамяти;

	Консоль.УстановитьПотокВывода(Лог);
	Текущий = Консоль.ПолучитьПотокВывода();
	Консоль.УстановитьПотокВывода(Неопределено);
	ПослеСброса = Консоль.ПолучитьПотокВывода();
	Консоль.УстановитьПотокВывода(Прежний);

	юТест.ПроверитьРавенство(Лог, Текущий);
	юТест.ПроверитьРавенство(Неопределено, ПослеСброса);
	юТест.ПроверитьРавенство(Прежний, Консоль.ПолучитьПотокВывода());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПолучениеПотокаОшибок() Экспорт

	Прежний = Консоль.ПолучитьПотокОшибок();
	Лог = Новый ПотокВПамяти;

	Консоль.УстановитьПотокОшибок(Лог);
	Текущий = Консоль.ПолучитьПотокОшибок();
	Консоль.УстановитьПотокОшибок(Неопределено);
	ПослеСброса = Консоль.ПолучитьПотокОшибок();
	Консоль.УстановитьПотокОшибок(Прежний);

	юТест.ПроверитьРавенство(Лог, Текущий);
	юТест.ПроверитьРавенство(Неопределено, ПослеСброса);
	юТест.ПроверитьРавенство(Прежний, Консоль.ПолучитьПотокОшибок());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоЗаданиеПолучаетУнаследованныйПотокВывода() Экспорт

	Прежний = Консоль.ПолучитьПотокВывода();
	Лог = Новый ПотокВПамяти;

	Консоль.УстановитьПотокВывода(Лог);
	Попытка
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПотокВыводаЗадания");
		Задание.ОжидатьЗавершения();
	Исключение
		Консоль.УстановитьПотокВывода(Прежний);
		ВызватьИсключение;
	КонецПопытки;
	Консоль.УстановитьПотокВывода(Прежний);

	ПроверитьЧтоЗаданияБезОшибок(МассивИз(Задание));
	юТест.ПроверитьРавенство(Лог, Задание.Результат);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьСменуКодировкиВыводаПослеПеренаправленияВЗадании() Экспорт

	// В отдельном процессе: кодировка консоли общая на процесс
	КодСкрипта = "Процедура Перенаправить() Экспорт
	             |	Консоль.УстановитьПотокВывода(Новый ПотокВПамяти);
	             |КонецПроцедуры
	             |ФоновыеЗадания.Выполнить(ЭтотОбъект, ""Перенаправить"").ОжидатьЗавершения();
	             |Консоль.КодировкаВыходногоПотока = КодировкаТекста.UTF16;
	             |Консоль.Вывести(""Привет"");";

	ТекстСкрипта = Новый ТекстовыйДокумент();
	ТекстСкрипта.УстановитьТекст(КодСкрипта);
	ВремФайл = ПолучитьИмяВременногоФайла("os");
	ТекстСкрипта.Записать(ВремФайл);

	ПутьКОскрипт = ОбъединитьПути(КаталогПрограммы(), "oscript.dll");
	Процесс = СоздатьПроцесс(СтрШаблон("dotnet ""%1"" ""%2""", ПутьКОскрипт, ВремФайл), , Истина, , КодировкаТекста.UTF16);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Вывод = Процесс.ПотокВывода.Прочитать();
	УдалитьФайлы(ВремФайл);

	юТест.ПроверитьРавенство("Привет", Вывод, "Вывод основного потока в новой кодировке");

КонецПроцедуры

Функция ПотокВыводаЗадания() Экспорт
	Возврат Консоль.ПолучитьПотокВывода();
КонецФункции

Процедура ВывестиСтрокиВСвойПоток(Поток, Текст) Экспорт
	Консоль.УстановитьПотокВывода(Поток);
	ВывестиСтроки(Текст);
КонецПроцедуры

Процедура ВывестиСтроки(Текст) Экспорт
	Для Счетчик = 1 По КоличествоСтрокВывода() Цикл
		Сообщить(Текст);
	КонецЦикла;
КонецПроцедуры

Функция КоличествоСтрокВывода()
	Возврат 200;
КонецФункции

Функция МассивИз(Элемент)
	Результат = Новый Массив;
	Результат.Добавить(Элемент);
	Возврат Результат;
КонецФункции

Процедура ПроверитьЧтоЗаданияБезОшибок(Задания)
	Для Каждого Задание Из Задания Цикл
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение Задание.ИнформацияОбОшибке.ПодробноеОписаниеОшибки();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьВыведенныеСтроки(Поток, ОжидаемаяСтрока, ОжидаемоеКоличество)

	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Чтение = Новый ЧтениеТекста(Поток, Консоль.КодировкаВыходногоПотока);
	Строки = СтрРазделить(Чтение.Прочитать(), Символы.ПС, Ложь);
	Чтение.Закрыть();

	юТест.ПроверитьРавенство(ОжидаемоеКоличество, Строки.Количество(), "Количество строк " + ОжидаемаяСтрока);
	Для Каждого Строка Из Строки Цикл
		юТест.ПроверитьРавенство(ОжидаемаяСтрока, СокрЛП(Строка));
	КонецЦикла;

КонецПроцедуры

Процедура ТестДолжен_ПроверитЦветКонсоли() Экспорт

	// Получение цвета не должно упасть

	ЦветТекста = Консоль.ЦветТекста;
	ЦветФона   = Консоль.ЦветФона;

	юТест.ПроверитьТип(ЦветТекста, "ЦветКонсоли");
	юТест.ПроверитьТип(ЦветФона,   "ЦветКонсоли");

КонецПроцедуры
