// Компонента, которая добавляет глобальный контекст (#344, #911). Сценарии из global-context
// выполняются отдельными процессами: подключение компоненты меняет глобальный контекст всего процесса,
// а порядок библиотек важен только при первой загрузке
#Использовать "component"

Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ПодключитьБиблиотекуСГлобальнымКонтекстомНеПоследней");
	ВсеТесты.Добавить("ТестДолжен_ПодключитьБиблиотекуСГлобальнымКонтекстомПоследней");
	ВсеТесты.Добавить("ТестДолжен_ЗагрузитьСценарийСБиблиотекойСГлобальнымКонтекстом");
	ВсеТесты.Добавить("ТестДолжен_ВычислитьПослеПодключенияГлобальногоКонтекста");
	ВсеТесты.Добавить("ТестДолжен_ВызватьМетодыОбъектовСозданныхДоПодключенияКомпоненты");

	Возврат ВсеТесты;

КонецФункции

Функция ВыполнитьСценарий(Знач ИмяСценария)

	ПутьСценария = ОбъединитьПути(ТекущийСценарий().Каталог, "global-context", ИмяСценария);
	Команда = СтрШаблон("dotnet ""%1"" -encoding=utf-8 ""%2""", ОбъединитьПути(КаталогПрограммы(), "oscript.dll"), ПутьСценария);
	Процесс = СоздатьПроцесс(Команда, , Истина, , КодировкаТекста.UTF8);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	Вывод = СокрЛП(СтрЗаменить(Процесс.ПотокВывода.Прочитать(), Символы.ВК, ""));
	Ошибки = СокрЛП(Процесс.ПотокОшибок.Прочитать());
	юТест.ПроверитьРавенство(0, Процесс.КодВозврата, Вывод + Символы.ПС + Ошибки);

	Возврат Вывод;

КонецФункции

Процедура ТестДолжен_ПодключитьБиблиотекуСГлобальнымКонтекстомНеПоследней() Экспорт

	Вывод = ВыполнитьСценарий("library-first.os");

	юТест.ПроверитьРавенство(
		"метод модуля
		|модуль другой библиотеки
		|метод компоненты
		|свойство компоненты", Вывод);

КонецПроцедуры

Процедура ТестДолжен_ПодключитьБиблиотекуСГлобальнымКонтекстомПоследней() Экспорт

	Вывод = ВыполнитьСценарий("library-last.os");

	юТест.ПроверитьРавенство(
		"метод модуля
		|модуль другой библиотеки
		|метод компоненты
		|свойство компоненты", Вывод);

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьСценарийСБиблиотекойСГлобальнымКонтекстом() Экспорт

	Вывод = ВыполнитьСценарий("load-script.os");

	юТест.ПроверитьРавенство("модуль другой библиотеки / метод компоненты / метод модуля", Вывод);

КонецПроцедуры

Процедура ТестДолжен_ВычислитьПослеПодключенияГлобальногоКонтекста() Экспорт

	Вывод = ВыполнитьСценарий("attach-at-runtime.os");

	юТест.ПроверитьРавенство(
		"переменная модуля / метод модуля / переменная модуля
		|переменная модуля / метод модуля / переменная модуля
		|метод компоненты
		|метод модуля", Вывод);

КонецПроцедуры

Процедура ТестДолжен_ВызватьМетодыОбъектовСозданныхДоПодключенияКомпоненты() Экспорт

	Вывод = ВыполнитьСценарий("objects-around-attach.os");

	юТест.ПроверитьРавенство(
		"поле объекта / поле объекта / метод объекта
		|поле объекта / поле объекта / метод объекта", Вывод);

КонецПроцедуры
