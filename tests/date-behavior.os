Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;

	ВсеТесты.Добавить("Тест_ДолженПроверить_ПрибавкаВышеТочности1СМеняетЗначение");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ПрибавкаНижеПоловиныШага1СИгнорируется");
	ВсеТесты.Добавить("Тест_ДолженПроверить_ПрибавкаОкругляетсяДоШага1С");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ДробнаяЧастьНеОкругляетсяДоСекунды");
	ВсеТесты.Добавить("Тест_ДолженПроверить_РазностьДатВозвращаетДробныеСекунды");
	ВсеТесты.Добавить("Тест_ДолженПроверить_РазностьДатНеЦелая");
	ВсеТесты.Добавить("Тест_ДолженПроверить_СравнениеРазличаетДробнуюЧасть");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ТекущаяДатаБезДолейСекунды");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ТекущаяУниверсальнаяДатаБезДолейСекунды");

	ВсеТесты.Добавить("Тест_ДолженПроверить_МестноеВремяБезДолейСекунды");
	ВсеТесты.Добавить("Тест_ДолженПроверить_КонвертацияПоясаСохраняетДробь");

	ВсеТесты.Добавить("Тест_ДолженПроверить_СтрокаСкрываетДробнуюЧасть");
	ВсеТесты.Добавить("Тест_ДолженПроверить_ФорматИгнорируетДробнуюЧасть");

	ВсеТесты.Добавить("Тест_ДолженПроверить_XMLСтрокаОтбрасываетДробнуюЧасть");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ЗаписьJsonНаивнойДаты");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ЗаписьJsonОтбрасываетДробнуюЧасть");
	ВсеТесты.Добавить("Тест_ДолженПроверить_ЗаписьJsonИгнорируетKind");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ЧтениеJsonБезИменСвойствДат");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ЧтениеJsonСИменамиСвойствДат");

	ВсеТесты.Добавить("Тест_ДолженПроверить_ПрочитатьДатуJsonОтбрасываетДробнуюЧасть");

	Возврат ВсеТесты;

КонецФункции

Функция БазоваяДата()

	Возврат Дата(2026, 2, 1, 15, 30, 45);

КонецФункции

Функция БезДробнойЧасти(Знач Дата)

	Возврат Дата(Год(Дата), Месяц(Дата), День(Дата), Час(Дата), Минута(Дата), Секунда(Дата));

КонецФункции

Функция ТекстJsonДляЧтенияДат()

	Возврат "{""a"":""2026-02-01T15:30:45"",
		|""b"":""2026-02-01T15:30:45.123"",
		|""c"":""2026-02-01T15:30:45Z"",
		|""d"":""2026-02-01T15:30:45+03:00"",
		|""e"":""2026-02-01T15:30:45.1234567Z""}";

КонецФункции

Функция ОжидаемаяЛокальнаяДатаИзUtc(Год, Месяц, День, Час, Минута, Секунда)

	Возврат БезДробнойЧасти(МестноеВремя(Дата(Год, Месяц, День, Час, Минута, Секунда)));

КонецФункции

Процедура Тест_ДолженПроверить_ПрибавкаВышеТочности1СМеняетЗначение() Экспорт

	База = БазоваяДата();
	Дельты = Новый Массив;
	Дельты.Добавить(0.001);
	Дельты.Добавить(0.1);
	Дельты.Добавить(0.5);
	Дельты.Добавить(0.999);
	Дельты.Добавить(0.0001);

	Для Каждого Дельта Из Дельты Цикл
		юТест.ПроверитьЛожь(База = (База + Дельта), "Прибавка " + Дельта + " должна менять значение");
	КонецЦикла;

КонецПроцедуры

Процедура Тест_ДолженПроверить_ПрибавкаНижеПоловиныШага1СИгнорируется() Экспорт

	База = БазоваяДата();
	Дельты = Новый Массив;
	Дельты.Добавить(0.00001);
	Дельты.Добавить(0.0000001);
	Дельты.Добавить(0.00004);

	Для Каждого Дельта Из Дельты Цикл
		юТест.ПроверитьИстину(База = (База + Дельта), "Прибавка " + Дельта + " должна игнорироваться");
	КонецЦикла;

КонецПроцедуры

Процедура Тест_ДолженПроверить_ПрибавкаОкругляетсяДоШага1С() Экспорт

	База = БазоваяДата();

	юТест.ПроверитьРавенство(0.0001, (База + 0.00005) - База);
	юТест.ПроверитьРавенство(0.0001, (База + 0.00006) - База);
	юТест.ПроверитьРавенство(0.0002, (База + 0.00016) - База);
	юТест.ПроверитьРавенство(0.0003, (База + 0.00025) - База);

	юТест.ПроверитьИстину((База + 0.00006) = (База + 0.0001));
	юТест.ПроверитьЛожь((База + 0.00016) = (База + 0.0001));
	юТест.ПроверитьИстину((База + 0.00016) = (База + 0.0002));

КонецПроцедуры

Процедура Тест_ДолженПроверить_ДробнаяЧастьНеОкругляетсяДоСекунды() Экспорт

	База = БазоваяДата();

	юТест.ПроверитьЛожь((База + 0.6) = База);
	юТест.ПроверитьЛожь((База + 0.6) = (База + 1));
	юТест.ПроверитьЛожь((База + 0.4) = База);
	юТест.ПроверитьЛожь((База + 0.0004) = База);
	юТест.ПроверитьЛожь((База + 0.0006) = База);

КонецПроцедуры

Процедура Тест_ДолженПроверить_РазностьДатВозвращаетДробныеСекунды() Экспорт

	База = БазоваяДата();

	юТест.ПроверитьРавенство(0.5, (База + 0.5) - База);
	юТест.ПроверитьРавенство(1.5, (База + 1.5) - База);
	юТест.ПроверитьРавенство(0.25, (База + 0.25) - База);
	юТест.ПроверитьРавенство(2, (База + 2) - База);

КонецПроцедуры

Процедура Тест_ДолженПроверить_РазностьДатНеЦелая() Экспорт

	База = БазоваяДата();
	Разность = (База + 0.5) - База;

	юТест.ПроверитьИстину(Разность <> Цел(Разность));

КонецПроцедуры

Процедура Тест_ДолженПроверить_СравнениеРазличаетДробнуюЧасть() Экспорт

	База = БазоваяДата();
	Дробная = База + 0.001;

	юТест.ПроверитьИстину(Дробная > База);
	юТест.ПроверитьИстину(Дробная >= База);
	юТест.ПроверитьЛожь(Дробная < База);
	юТест.ПроверитьЛожь(База = Дробная);
	юТест.ПроверитьИстину(База <> Дробная);

КонецПроцедуры

Процедура Тест_ДолженПроверить_ТекущаяДатаБезДолейСекунды() Экспорт

	ТекДата = ТекущаяДата();

	юТест.ПроверитьРавенство(ТекДата, БезДробнойЧасти(ТекДата));
	юТест.ПроверитьРавенство(0, ТекДата - БезДробнойЧасти(ТекДата));

КонецПроцедуры

Процедура Тест_ДолженПроверить_ТекущаяУниверсальнаяДатаБезДолейСекунды() Экспорт

	УнивДата = ТекущаяУниверсальнаяДата();

	юТест.ПроверитьРавенство(УнивДата, БезДробнойЧасти(УнивДата));
	юТест.ПроверитьРавенство(0, УнивДата - БезДробнойЧасти(УнивДата));

КонецПроцедуры

Процедура Тест_ДолженПроверить_МестноеВремяБезДолейСекунды() Экспорт

	Унив = БезДробнойЧасти(ТекущаяУниверсальнаяДата());
	Местн = МестноеВремя(Унив);

	юТест.ПроверитьРавенство(Местн, БезДробнойЧасти(Местн));

КонецПроцедуры

Процедура Тест_ДолженПроверить_КонвертацияПоясаСохраняетДробь() Экспорт

	Дробная = БазоваяДата() + 0.001;

	юТест.ПроверитьРавенство(Дробная, МестноеВремя(УниверсальноеВремя(Дробная)));

КонецПроцедуры

Процедура Тест_ДолженПроверить_СтрокаСкрываетДробнуюЧасть() Экспорт

	База = БазоваяДата();
	Дробная = База + 0.123;

	юТест.ПроверитьРавенство(Строка(База), Строка(Дробная));

КонецПроцедуры

Процедура Тест_ДолженПроверить_ФорматИгнорируетДробнуюЧасть() Экспорт

	Дробная = БазоваяДата() + 0.123;

	юТест.ПроверитьРавенство("45", Формат(Дробная, "ДФ=сс"));
	юТест.ПроверитьРавенство("20260201153045", Формат(Дробная, "ДФ=ггггММддЧЧммсс"));

КонецПроцедуры

Процедура Тест_ДолженПроверить_XMLСтрокаОтбрасываетДробнуюЧасть() Экспорт

	Дробная = БазоваяДата() + 0.123;

	юТест.ПроверитьРавенство("2026-02-01T15:30:45", XMLСтрока(Дробная));

КонецПроцедуры

Процедура Тест_ДолженПроверить_ЗаписьJsonНаивнойДаты() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Литерал", БазоваяДата());
	Данные.Вставить("ПустаяДата", Дата(1, 1, 1));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Текст = Запись.Закрыть();

	юТест.ПроверитьВхождение(Текст, """Литерал"": ""2026-02-01T15:30:45""");
	юТест.ПроверитьВхождение(Текст, """ПустаяДата"": ""0001-01-01T00:00:00""");

КонецПроцедуры

Процедура Тест_ДолженПроверить_ЗаписьJsonОтбрасываетДробнуюЧасть() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("Дробная", БазоваяДата() + 0.123);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Текст = Запись.Закрыть();

	юТест.ПроверитьВхождение(Текст, """Дробная"": ""2026-02-01T15:30:45""");
	юТест.ПроверитьЛожь(СтрНайти(Текст, ".123") > 0);

КонецПроцедуры

Процедура Тест_ДолженПроверить_ЗаписьJsonИгнорируетKind() Экспорт

	Данные = Новый Структура;
	Данные.Вставить("ТекущаяДата", БезДробнойЧасти(ТекущаяДата()));
	Данные.Вставить("УниверсальнаяДата", БезДробнойЧасти(ТекущаяУниверсальнаяДата()));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Текст = Запись.Закрыть();

	юТест.ПроверитьЛожь(СтрНайти(Текст, "Z") > 0);
	юТест.ПроверитьЛожь(СтрНайти(Текст, "+") > 0);

КонецПроцедуры

Процедура Тест_ДолженПроверить_ЧтениеJsonБезИменСвойствДат() Экспорт

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТекстJsonДляЧтенияДат());
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	юТест.ПроверитьРавенство(Тип("Строка"), ТипЗнч(Данные.a));
	юТест.ПроверитьРавенство(Тип("Строка"), ТипЗнч(Данные.b));
	юТест.ПроверитьРавенство(Тип("Строка"), ТипЗнч(Данные.c));
	юТест.ПроверитьРавенство(Тип("Строка"), ТипЗнч(Данные.d));
	юТест.ПроверитьРавенство(Тип("Строка"), ТипЗнч(Данные.e));

	юТест.ПроверитьРавенство("2026-02-01T15:30:45", Данные.a);
	юТест.ПроверитьРавенство("2026-02-01T15:30:45.123", Данные.b);
	юТест.ПроверитьРавенство("2026-02-01T15:30:45Z", Данные.c);
	юТест.ПроверитьРавенство("2026-02-01T15:30:45+03:00", Данные.d);
	юТест.ПроверитьРавенство("2026-02-01T15:30:45.1234567Z", Данные.e);

КонецПроцедуры

Процедура Тест_ДолженПроверить_ЧтениеJsonСИменамиСвойствДат() Экспорт

	ИменаСвойств = Новый Массив;
	ИменаСвойств.Добавить("a");
	ИменаСвойств.Добавить("b");
	ИменаСвойств.Добавить("c");
	ИменаСвойств.Добавить("d");
	ИменаСвойств.Добавить("e");

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТекстJsonДляЧтенияДат());
	Данные = ПрочитатьJSON(Чтение, Ложь, ИменаСвойств, ФорматДатыJSON.ISO);
	Чтение.Закрыть();

	ОжиданиеC = ОжидаемаяЛокальнаяДатаИзUtc(2026, 2, 1, 15, 30, 45);
	ОжиданиеD = ОжидаемаяЛокальнаяДатаИзUtc(2026, 2, 1, 12, 30, 45);

	юТест.ПроверитьРавенство(Тип("Дата"), ТипЗнч(Данные.a));
	юТест.ПроверитьРавенство(Тип("Дата"), ТипЗнч(Данные.b));
	юТест.ПроверитьРавенство(Тип("Дата"), ТипЗнч(Данные.c));
	юТест.ПроверитьРавенство(Тип("Дата"), ТипЗнч(Данные.d));
	юТест.ПроверитьРавенство(Тип("Дата"), ТипЗнч(Данные.e));

	юТест.ПроверитьРавенство(Дата(2026, 2, 1, 15, 30, 45), Данные.a);
	юТест.ПроверитьРавенство(Дата(2026, 2, 1, 15, 30, 45), Данные.b);
	юТест.ПроверитьРавенство(ОжиданиеC, Данные.c);
	юТест.ПроверитьРавенство(ОжиданиеD, Данные.d);
	юТест.ПроверитьРавенство(ОжиданиеC, Данные.e);

	юТест.ПроверитьИстину(Данные.a = БезДробнойЧасти(Данные.a));
	юТест.ПроверитьИстину(Данные.b = БезДробнойЧасти(Данные.b));
	юТест.ПроверитьИстину(Данные.c = БезДробнойЧасти(Данные.c));
	юТест.ПроверитьИстину(Данные.d = БезДробнойЧасти(Данные.d));
	юТест.ПроверитьИстину(Данные.e = БезДробнойЧасти(Данные.e));

КонецПроцедуры

Процедура Тест_ДолженПроверить_ПрочитатьДатуJsonОтбрасываетДробнуюЧасть() Экспорт

	Результат = ПрочитатьДатуJSON("2026-02-01T15:30:45.123", ФорматДатыJSON.ISO);

	юТест.ПроверитьРавенство(Дата(2026, 2, 1, 15, 30, 45), Результат);
	юТест.ПроверитьИстину(Результат = БезДробнойЧасти(Результат));

КонецПроцедуры
