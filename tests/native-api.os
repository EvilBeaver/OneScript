Процедура ТестДолжен_БалансироватьСчётчикиЖизненногоЦикла() Экспорт

	КомпонентаПодключена = ПодключитьКомпонентуDLL();
	юТест.ПроверитьИстину(КомпонентаПодключена, "Компонента должна подключиться");

	ИмяВнешнейКомпоненты = "AddIn.AddinNativeDLL.CAddInNative";
	Зонд = Новый(ИмяВнешнейКомпоненты);

	КонструкторовДо = Зонд.ПолучитьСчётчикКонструкторов();
	ДеструкторовДо = Зонд.ПолучитьСчётчикДеструкторов();

	КоличествоОбъектов = 20;
	Для Номер = 1 По КоличествоОбъектов Цикл
		Объект = Новый(ИмяВнешнейКомпоненты);
		Объект = Неопределено;
		ВыполнитьСборкуМусора();
	КонецЦикла;

	КонструкторовПосле = Зонд.ПолучитьСчётчикКонструкторов();
	ДеструкторовПосле = Зонд.ПолучитьСчётчикДеструкторов();

	юТест.ПроверитьРавенство(
		КонструкторовПосле - КонструкторовДо,
		КоличествоОбъектов,
		"Каждый созданный объект должен увеличивать счётчик конструкторов");
	юТест.ПроверитьРавенство(
		ДеструкторовПосле,
		ДеструкторовДо,
		"Сборка мусора не должна вызывать деструкторы компоненты");

КонецПроцедуры

