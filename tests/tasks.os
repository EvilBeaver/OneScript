	НаполнитьРеестрЗаданиями();
	ПроверитьОтсутствиеОшибокВЗаданиях(Задания);
	
КонецПроцедуры

Процедура ТестДолжен_ПроверитьПоискТекущегоСредиМножестваЗавершенных() Экспорт
	
	Для Номер = 1 По 200 Цикл
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "Пустышка");
		Задание.ОжидатьЗавершения();
	КонецЦикла;
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания");
