	ВсеТесты.Добавить("ТестДолжен_ЗахватитьБлокировкуДоИстеченияТаймаута");
	ВсеТесты.Добавить("ТестДолжен_ЗапретитьОтрицательныйТаймаутБлокировки");
	
	Возврат ВсеТесты;
	
КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	ФоновыеЗадания.Очистить();
КонецПроцедуры

Процедура ПроцедураБезПараметров() Экспорт
	Приостановить(500);
КонецПроцедуры

Процедура ПроцедураСПараметрами(Интервал) Экспорт
	Приостановить(Интервал);
КонецПроцедуры

Процедура ПроцедураСИсключением() Экспорт
	Приостановить(500);
	ВызватьИсключение "Я ошибка в коде";
КонецПроцедуры

Функция ПодсчетСуммы(Знач Начало, Знач Конец) Экспорт
	
	//дадим всем заданиям шанс начаться
	Приостановить(500);

	СуммаНаОтрезке = 0;
	Для Сч = Начало По Конец Цикл
		СуммаНаОтрезке = СуммаНаОтрезке + Сч;
	КонецЦикла;

	Возврат СуммаНаОтрезке;

КонецФункции

Процедура ПодсчетГлобальнойСуммы(Знач Начало, Знач Конец) Экспорт
	
	СуммаНаОтрезке = ПодсчетСуммы(Начало, Конец);

	глБлокировка.Заблокировать();
	глСумма = глСумма + СуммаНаОтрезке;
	глБлокировка.Разблокировать();
	
КонецПроцедуры

Процедура Событие() Экспорт
	СобытиеВызвано = Истина;
КонецПроцедуры

Процедура ТестДолжен_ПроверитьСозданиеЗаданий() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	юТест.ПроверитьИстину(ЗначениеЗаполнено(Задание.УникальныйИдентификатор));
	юТест.ПроверитьРавенство("ПроцедураБезПараметров", Задание.ИмяМетода);
	юТест.ПроверитьРавенство(ЭтотОбъект, Задание.Объект);
	юТест.ПроверитьРавенство(Неопределено, Задание.Параметры);
	
	Задание.ОжидатьЗавершения();

	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Состояние);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПоискЗаданий() Экспорт
	
	З = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");

	Все = ФоновыеЗадания.ПолучитьФоновыеЗадания();
	юТест.ПроверитьРавенство(4, Все.Количество());

	ПоИд = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("UUID", З.УникальныйИдентификатор));
	юТест.ПроверитьРавенство(1, ПоИд.Количество());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьОжиданиеВсехЗаданий() Экспорт
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(3000);
	
	МассивЗаданий = Новый Массив;
	
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураСПараметрами", МассивПараметров));
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров"));
	
	ФоновыеЗадания.ОжидатьВсе(МассивЗаданий);

	Завершенные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Завершено));
	юТест.ПроверитьРавенство(2, Завершенные.Количество());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьОжиданиеЛюбогоИзЗаданий() Экспорт
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(3000);
	
	МассивЗаданий = Новый Массив;
	
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураСПараметрами", МассивПараметров));
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров"));
	
	ФоновыеЗадания.ОжидатьЛюбое(МассивЗаданий);

	Завершенные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Завершено));
	юТест.ПроверитьМеньшеИлиРавно(Завершенные.Количество(), 2);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьОжиданиеКонкретногоЗадания() Экспорт
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	Задание.ОжидатьЗавершения();

	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Состояние);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоВЗаданииПроставленаИнформацияОбОшибке() Экспорт
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураСИсключением");
	Задание.ОжидатьЗавершения();

	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.ЗавершеноАварийно, Задание.Состояние);
	юТест.ПроверитьРавенство("Я ошибка в коде", Задание.ИнформацияОбОшибке.Описание);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоВозвращаетсяРезультат() Экспорт
	
	МассивПараметров = Новый Массив(2);
	МассивПараметров[0] = 1;
	МассивПараметров[1] = 100;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетСуммы", МассивПараметров);

	МассивПараметров[0] = 101;
	МассивПараметров[1] = 200;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетСуммы", МассивПараметров);

	МассивПараметров[0] = 201;
	МассивПараметров[1] = 300;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетСуммы", МассивПараметров);

	ВсеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания();
	ФоновыеЗадания.ОжидатьВсе(ВсеЗадания);

	Сумма = 0;
	Для Каждого Задание Из ВсеЗадания Цикл
		Сумма = Сумма + Задание.Результат;
	КонецЦикла;

	юТест.ПроверитьРавенство(45150, Сумма);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоВозвращаетсяРезультатДелегата() Экспорт
	
    Делегат = Новый Действие(ЭтотОбъект, "ПодсчетСуммы");

	МассивПараметров = Новый Массив(2);
	МассивПараметров[0] = 1;
	МассивПараметров[1] = 5;

	ФЗ = ФоновыеЗадания.Выполнить(Делегат, "Выполнить", МассивПараметров);

	ФЗ.ОжидатьЗавершения();

	юТест.ПроверитьРавенство(15, ФЗ.Результат);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоРаботаетБлокировка() Экспорт
	
	глБлокировка = Новый БлокировкаРесурса;
	глСумма = 0;
	
	МассивПараметров = Новый Массив(2);
	МассивПараметров[0] = 1;
	МассивПараметров[1] = 1000;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетГлобальнойСуммы", МассивПараметров);

	МассивПараметров[0] = 1001;
	МассивПараметров[1] = 2000;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетГлобальнойСуммы", МассивПараметров);

	МассивПараметров[0] = 2001;
	МассивПараметров[1] = 3000;

	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодсчетГлобальнойСуммы", МассивПараметров);

	Попытка
		ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	Исключение
		МассивОшибок = ИнформацияОбОшибке().Параметры;
		Если МассивОшибок <> Неопределено Тогда
			Для Каждого Задание Из МассивОшибок Цикл
				Сообщить(Задание.ИнформацияОбОшибке.ПодробноеОписаниеОшибки());
			КонецЦикла;
		КонецЕсли;
	КонецПопытки;

	юТест.ПроверитьРавенство(4501500, глСумма);

КонецПроцедуры

Функция ПроверитьИдентификаторЗадания() Экспорт
	
	Приостановить(500);
	Задание = ФоновыеЗадания.ПолучитьТекущее();
	Если Задание <> Неопределено Тогда
		Возврат Задание.УникальныйИдентификатор;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ТестДолжен_ПроверитьЧтоКодМожетОпределитьИДЗадания() Экспорт
	
	МассивЗаданий = Новый Массив;
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания"));
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания"));
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания"));
	МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания"));
	
	ФоновыеЗадания.ОжидатьВсе(МассивЗаданий);
	
	Для Каждого Задание Из МассивЗаданий Цикл
		юТест.ПроверитьРавенство(Задание.УникальныйИдентификатор, Задание.Результат);
		юТест.ПроверитьНеРавенство(Неопределено, Задание.Результат);
	КонецЦикла;
	
	ЗаданиеГлавногоПотока = ФоновыеЗадания.ПолучитьТекущее();
	юТест.ПроверитьРавенство(Неопределено, ЗаданиеГлавногоПотока);

КонецПроцедуры

Функция ВернутьИдентификаторПотокаИсполнения() Экспорт
	
	Приостановить(500);
	Возврат ТекущийПоток().Идентификатор;
	
КонецФункции

Процедура ТестДолжен_ПроверитьУникальностьПотокаИсполнения() Экспорт
	
	ИдОсновногоПотока = ТекущийПоток().Идентификатор;
	юТест.ПроверитьРавенство(ИдОсновногоПотока, ТекущийПоток().Идентификатор,
		"Идентификатор потока исполнения должен быть одинаковым при повторном вызове");
	
	МассивЗаданий = Новый Массив;
	Для Сч = 1 По 4 Цикл
		МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВернутьИдентификаторПотокаИсполнения"));
	КонецЦикла;
	
	ФоновыеЗадания.ОжидатьВсе(МассивЗаданий);
	
	УникальныеИдентификаторы = Новый Соответствие;
	Для Каждого Задание Из МассивЗаданий Цикл
		юТест.ПроверитьНеРавенство(ИдОсновногоПотока, Задание.Результат,
			"Фоновое задание должно получить собственный поток исполнения");
		УникальныеИдентификаторы.Вставить(Задание.Результат, Истина);
	КонецЦикла;
	
	юТест.ПроверитьРавенство(МассивЗаданий.Количество(), УникальныеИдентификаторы.Количество(),
		"Идентификаторы одновременных фоновых заданий должны различаться");
	
КонецПроцедуры

Функция ЗаписатьВДанныеПотокаИЗабрать(Знач Метка) Экспорт
	
	ТекущийПоток().Данные.Вставить("метка", Метка);
	Приостановить(500);
	
	// Данные основного потока не должны быть видны, а соседние задания не должны затирать наши
	Результат = Новый Структура("Метка, ЕстьЧужое");
	Результат.Метка = ТекущийПоток().Данные.Получить("метка");
	Результат.ЕстьЧужое = (ТекущийПоток().Данные.Получить("изОсновногоПотока") <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Процедура ТестДолжен_ПроверитьИзоляциюДанныхПотокаИсполнения() Экспорт
	
	ТекущийПоток().Данные.Вставить("изОсновногоПотока", Истина);
	
	юТест.ПроверитьРавенство(Истина, ТекущийПоток().Данные.Получить("изОсновногоПотока"),
		"ТекущийПоток() должен возвращать один и тот же экземпляр в пределах потока исполнения");
	
	МассивЗаданий = Новый Массив;
	Для Сч = 1 По 4 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Сч);
		МассивЗаданий.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗаписатьВДанныеПотокаИЗабрать", Параметры));
	КонецЦикла;
	
	ФоновыеЗадания.ОжидатьВсе(МассивЗаданий);
	
	Для Сч = 1 По МассивЗаданий.Количество() Цикл
		Результат = МассивЗаданий[Сч - 1].Результат;
		юТест.ПроверитьРавенство(Сч, Результат.Метка,
			"Данные потока исполнения не должны затираться соседними фоновыми заданиями");
		юТест.ПроверитьРавенство(Ложь, Результат.ЕстьЧужое,
			"Фоновое задание не должно видеть данные основного потока исполнения");
	КонецЦикла;
	
	ТекущийПоток().Данные.Удалить("изОсновногоПотока");
	
КонецПроцедуры

Функция ПоложитьВДанныеПотокаОсвобождаемыйОбъект() Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("tmp");
	ФайловыйПоток = Новый ФайловыйПоток(ИмяФайла, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	
	ТекущийПоток().Данные.Вставить("файл", ФайловыйПоток);
	
	// Возвращаем и сам поток исполнения, и объект - чтобы проверить их состояние после завершения задания
	Возврат Новый Структура("ПотокИсполнения, ФайловыйПоток, ИмяФайла",
		ТекущийПоток(), ФайловыйПоток, ИмяФайла);
	
КонецФункции

Процедура ТестДолжен_ПроверитьОсвобождениеДанныхПотокаИсполнения() Экспорт
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВДанныеПотокаОсвобождаемыйОбъект");
	Задание.ОжидатьЗавершения();
	
	Результат = Задание.Результат;
	юТест.ПроверитьНеРавенство(Неопределено, Результат, "Задание должно вернуть результат");
	
	юТест.ПроверитьРавенство(0, Результат.ПотокИсполнения.Данные.Количество(),
		"Данные потока исполнения должны очищаться по завершении фонового задания");
	
	ИсключениеБыло = Ложь;
	Попытка
		Результат.ФайловыйПоток.ТекущаяПозиция();
	Исключение
		ИсключениеБыло = Истина;
	КонецПопытки;
	
	юТест.ПроверитьРавенство(Истина, ИсключениеБыло,
		"Значения данных потока исполнения должны принудительно освобождаться");
	
	УдалитьФайлы(Результат.ИмяФайла);
	
КонецПроцедуры

Процедура ПриЗавершенииПотокаЗадания() Экспорт
	
	ЗавершениеПотокаЗафиксировано = Истина;
	// Обработчик должен успевать увидеть данные потока до их очистки
	ЭлементовВДанныхПриЗавершении = ТекущийПоток().Данные.Количество();
	
КонецПроцедуры

Функция ПодписатьсяНаЗавершениеПотока() Экспорт
	
	ТекущийПоток().Данные.Вставить("ресурс", "значение");
	ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ЭтотОбъект.ПриЗавершенииПотокаЗадания;
	Возврат ТекущийПоток();
	
КонецФункции

Процедура ТестДолжен_ВызватьОбработчикЗавершенияПотокаИсполнения() Экспорт
	
	ЗавершениеПотокаЗафиксировано = Ложь;
	ЭлементовВДанныхПриЗавершении = -1;
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодписатьсяНаЗавершениеПотока");
	Задание.ОжидатьЗавершения();
	
	юТест.ПроверитьРавенство(Истина, ЗавершениеПотокаЗафиксировано,
		"Обработчик ПриЗавершении должен вызываться по завершении потока исполнения");
	
	юТест.ПроверитьРавенство(1, ЭлементовВДанныхПриЗавершении,
		"Обработчик должен видеть данные потока до их очистки");
	
	юТест.ПроверитьРавенство(0, Задание.Результат.Данные.Количество(),
		"После обработчика данные потока должны быть очищены");
	
КонецПроцедуры

Процедура ПриЗавершенииПотокаСИсключением() Экспорт
	ВызватьИсключение "Ошибка внутри обработчика завершения";
КонецПроцедуры

Функция ПодписатьсяНаПадающийОбработчик() Экспорт
	ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ЭтотОбъект.ПриЗавершенииПотокаСИсключением;
	Возврат "задание отработало";
КонецФункции

Процедура ТестДолжен_НеРонятьЗаданиеИзЗаОшибкиВОбработчикеЗавершения() Экспорт
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПодписатьсяНаПадающийОбработчик");
	Задание.ОжидатьЗавершения();
	
	юТест.ПроверитьРавенство("задание отработало", Задание.Результат,
		"Ошибка в обработчике завершения не должна ломать результат задания");
	
	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Состояние,
		"Ошибка в обработчике завершения не должна менять состояние задания");

КонецПроцедуры

// Создаёт значение, освобождение которого завершается ошибкой.
//
// ЗаписьДанных при освобождении сбрасывает буфер в нижележащий поток, а он уже закрыт.
//
// Параметры:
//   ИмяФайла - Строка - Файл, поверх которого строится значение.
//
Функция ПадающийПриОсвобожденииРесурс(Знач ИмяФайла)

	ФайловыйПоток = Новый ФайловыйПоток(ИмяФайла, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	Писатель = Новый ЗаписьДанных(ФайловыйПоток);
	Писатель.ЗаписатьСтроку("данные, которые придётся сбрасывать при закрытии");
	ФайловыйПоток.Закрыть();

	Возврат Писатель;

КонецФункции

Функция ПоложитьВДанныеПадающийИИсправныйРесурсы() Экспорт

	ФайлПадающего = ПолучитьИмяВременногоФайла("tmp");
	ФайлИсправного = ПолучитьИмяВременногоФайла("tmp");

	Исправный = Новый ФайловыйПоток(ФайлИсправного, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);

	ТекущийПоток().Данные.Вставить("падающий", ПадающийПриОсвобожденииРесурс(ФайлПадающего));
	ТекущийПоток().Данные.Вставить("исправный", Исправный);

	// Пути возвращаются вызывающему: закрытие потоков файлы не удаляет
	Возврат Новый Структура("Поток, Исправный, Файлы", ТекущийПоток(), Исправный,
		ОбщегоНазначенияМассивИз(ФайлПадающего, ФайлИсправного));

КонецФункции

// Собирает массив из переданных значений.
//
Функция ОбщегоНазначенияМассивИз(Знач Первое, Знач Второе)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);

	Возврат Результат;

КонецФункции

// Ошибка освобождения одного значения не должна ни ронять задание, ни оставлять
// неосвобождёнными остальные значения.
//
Процедура ТестДолжен_ОсвободитьОстальныеДанныеПриОшибкеОсвобождения() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПоложитьВДанныеПадающийИИсправныйРесурсы");
	Задание.ОжидатьЗавершения();

	Результат = Задание.Результат;

	Попытка

		юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Состояние,
			"Ошибка освобождения значения не должна менять состояние задания");

		юТест.ПроверитьНеРавенство(Неопределено, Результат, "Задание должно вернуть результат");

		юТест.ПроверитьРавенство(0, Результат.Поток.Данные.Количество(),
			"Данные потока должны очищаться даже при ошибке освобождения одного из значений");

		ИсправныйОсвобожден = Ложь;
		Попытка
			Результат.Исправный.ТекущаяПозиция();
		Исключение
			ИсправныйОсвобожден = Истина;
		КонецПопытки;

		юТест.ПроверитьРавенство(Истина, ИсправныйОсвобожден,
			"Исправное значение должно освобождаться независимо от ошибки на соседнем");

	Исключение
		УдалитьВременныеФайлы(Результат);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныеФайлы(Результат);

КонецПроцедуры

// Удаляет временные файлы, созданные заданием: закрытие потоков их не удаляет.
//
Процедура УдалитьВременныеФайлы(Знач Результат)

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяФайла Из Результат.Файлы Цикл
		Если Новый Файл(ИмяФайла).Существует() Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поток исполнения основного скрипта тоже завершается: обработчик ПриЗавершении должен
// сработать по окончании скрипта, а не остаться невызванным до конца процесса.
//
// Проверяется дочерним oscript: изнутри самого скрипта момент его завершения не наблюдаем.
// Дочерний процесс подписывается на завершение своего потока и пишет из обработчика файл-метку,
// родитель дожидается завершения и смотрит на метку.
//
Процедура ТестДолжен_ОсвободитьДанныеПотокаОсновногоСкрипта() Экспорт

	ФайлМетки = ПолучитьИмяВременногоФайла("txt");
	ФайлСкрипта = ПолучитьИмяВременногоФайла("os");

	ТекстСкрипта = Новый ЗаписьТекста(ФайлСкрипта, КодировкаТекста.UTF8);
	ТекстСкрипта.ЗаписатьСтроку("Процедура ПриЗавершении() Экспорт");
	ТекстСкрипта.ЗаписатьСтроку("	Запись = Новый ЗаписьТекста(""" + СтрЗаменить(ФайлМетки, "\", "\\") + """);");
	ТекстСкрипта.ЗаписатьСтроку("	Запись.ЗаписатьСтроку(""элементов="" + ТекущийПоток().Данные.Количество());");
	ТекстСкрипта.ЗаписатьСтроку("	Запись.Закрыть();");
	ТекстСкрипта.ЗаписатьСтроку("КонецПроцедуры");
	ТекстСкрипта.ЗаписатьСтроку("ТекущийПоток().Данные.Вставить(""ключ"", ""значение"");");
	ТекстСкрипта.ЗаписатьСтроку("ДобавитьОбработчик ТекущийПоток().ПриЗавершении, ЭтотОбъект.ПриЗавершении;");
	ТекстСкрипта.Закрыть();

	Попытка

		Процесс = СоздатьПроцесс("dotnet """ + КаталогПрограммы() + "/oscript.dll"" """ + ФайлСкрипта + """");
		Процесс.Запустить();
		Процесс.ОжидатьЗавершения();

		юТест.ПроверитьРавенство(0, Процесс.КодВозврата, "Дочерний скрипт должен отработать без ошибки");

		юТест.ПроверитьРавенство(Истина, Новый Файл(ФайлМетки).Существует(),
			"Обработчик ПриЗавершении должен вызываться и для потока основного скрипта");

		Чтение = Новый ЧтениеТекста(ФайлМетки);
		Метка = СокрЛП(Чтение.ПрочитатьСтроку());
		Чтение.Закрыть();

		юТест.ПроверитьРавенство("элементов=1", Метка,
			"Обработчик должен видеть данные потока основного скрипта до их очистки");

	Исключение
		УдалитьФайлы(ФайлСкрипта);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ФайлСкрипта);
	Если Новый Файл(ФайлМетки).Существует() Тогда
		УдалитьФайлы(ФайлМетки);
	КонецЕсли;

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоВИнформацииОбОшибкеЕстьСтекВызовов() Экспорт

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураСИсключением");
	Задание.ОжидатьЗавершения();

	СтекВызовов = Задание.ИнформацияОбОшибке.ПолучитьСтекВызовов();

	юТест.ПроверитьТип(СтекВызовов, "КоллекцияКадровСтекаВызовов");

	юТест.ПроверитьРавенство(СтекВызовов.Количество(), 1);

	юТест.ПроверитьРавенство(СтекВызовов[0].Метод, "ПроцедураСИсключением");
	юТест.ПроверитьЗаполненность(СтекВызовов[0].НомерСтроки);
	юТест.ПроверитьРавенство(СтекВызовов[0].ИмяМодуля, ТекущийСценарий().Источник);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоОбработчикиСобытийВызываютсяВФоновомЗадании() Экспорт

	СобытиеВызвано = Ложь;

	Параметры = Новый Массив;
	Параметры.Добавить("ЯСобытие");
	Параметры.Добавить(Новый Массив);

	ДобавитьОбработчик ЭтотОбъект.ЯСобытие, Событие;

	ФоновоеЗадание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВызватьСобытие", Параметры);
	ФоновоеЗадание.ОжидатьЗавершения();

	УдалитьОбработчик ЭтотОбъект.ЯСобытие, Событие;

	юТест.ПроверитьИстину(
		СобытиеВызвано,
		"Ожидали что при вызове события в фоновом задании вызовется, а это не так"
	);

КонецПроцедуры

Процедура ПрочитатьЗначениеПеречисления() Экспорт
	Значение = НаправлениеПоиска.СКонца;
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Не удалось прочитать значение системного перечисления";
	КонецЕсли;
КонецПроцедуры

Процедура ТестДолжен_ПроверитьПараллельноеЧтениеЗначенияСистемногоПеречисления() Экспорт

	КоличествоЗаданий = 200;
	Задания = Новый Массив;

	Для НомерЗадания = 1 По КоличествоЗаданий Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПрочитатьЗначениеПеречисления", , Истина));
	КонецЦикла;

	ФоновыеЗадания.ОжидатьВсе(Задания);
	ПроверитьОтсутствиеОшибокВЗаданиях(Задания);

КонецПроцедуры

Процедура Пустышка() Экспорт
КонецПроцедуры

Процедура ДергатьТекущее() Экспорт
	Для Счетчик = 1 По 20000 Цикл
		Текущее = ФоновыеЗадания.ПолучитьТекущее();
		Если Текущее = Неопределено Тогда
			ВызватьИсключение "Не найдено текущее задание";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДергатьСписокЗаданий() Экспорт
	Для Счетчик = 1 По 20000 Цикл
		ФоновыеЗадания.ПолучитьФоновыеЗадания();
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОтсутствиеОшибокВЗаданиях(Задания)
	
	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения(60000);
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение Задание.ИнформацияОбОшибке.Описание;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура НаполнитьРеестрЗаданиями()
	
	Для Номер = 1 По 300 Цикл
		ФоновыеЗадания.Выполнить(ЭтотОбъект, "Пустышка");
	КонецЦикла;
	
КонецПроцедуры

Процедура ТестДолжен_ПроверитьПотокобезопасностьПолучитьТекущее() Экспорт
	
	Задания = Новый Массив;
	Для Номер = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДергатьТекущее", Новый Массив, Истина));
	КонецЦикла;
	
	НаполнитьРеестрЗаданиями();
	ПроверитьОтсутствиеОшибокВЗаданиях(Задания);
	
КонецПроцедуры

Процедура ТестДолжен_ПроверитьПотокобезопасностьПолучитьФоновыеЗадания() Экспорт
	
	Задания = Новый Массив;
	Для Номер = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДергатьСписокЗаданий", Новый Массив, Истина));
	КонецЦикла;
	
	НаполнитьРеестрЗаданиями();
	ПроверитьОтсутствиеОшибокВЗаданиях(Задания);
	
КонецПроцедуры

Процедура ТестДолжен_ПроверитьПоискТекущегоСредиМножестваЗавершенных() Экспорт
	
	Для Номер = 1 По 200 Цикл
		Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "Пустышка");
		Задание.ОжидатьЗавершения();
	КонецЦикла;
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроверитьИдентификаторЗадания");
	Задание.ОжидатьЗавершения();
	
	юТест.ПроверитьРавенство(Задание.УникальныйИдентификатор, Задание.Результат);
	юТест.ПроверитьНеРавенство(Неопределено, Задание.Результат);
	
КонецПроцедуры

