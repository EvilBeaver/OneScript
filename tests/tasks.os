КонецПроцедуры

Процедура ЦиклДоОтмены(Сигнал) Экспорт
	Сигнал.Добавить(Истина);
	Пока Истина Цикл
		Приостановить(10);
	КонецЦикла;
КонецПроцедуры

Процедура ЖдатьДругоеЗадание(Сигнал, Параметры) Экспорт
	
	Цель = Параметры.Цель;
	Задания = Новый Массив;
	Задания.Добавить(Цель);
	
	Сигнал.Добавить(Истина);
	Если Параметры.Способ = "ОжидатьЗавершения" Тогда
		Цель.ОжидатьЗавершения();
	ИначеЕсли Параметры.Способ = "ОжидатьВсе" Тогда
		ФоновыеЗадания.ОжидатьВсе(Задания);
	ИначеЕсли Параметры.Способ = "ОжидатьЛюбое" Тогда
		ФоновыеЗадания.ОжидатьЛюбое(Задания);
	ИначеЕсли Параметры.Способ = "ОжидатьЗавершенияЗадач" Тогда
		ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОтменуОжиданияДругогоЗадания(Способ)
	
	Цель = ЗапуститьСоСигналом(ЭтотОбъект, "ЦиклДоОтмены");
	Ждущее = ЗапуститьСоСигналом(ЭтотОбъект, "ЖдатьДругоеЗадание", Новый Структура("Цель, Способ", Цель, Способ));
	
	Ждущее.Отменить();
	Остановилось = Ждущее.ОжидатьЗавершения(10000);
	Цель.Отменить();
	
	юТест.ПроверитьИстину(Остановилось, "Ожидание другого задания должно прерываться отменой");
	ПроверитьЧтоЗаданиеОтменено(Ждущее);
	ПроверитьЧтоЗаданиеОтменено(Цель);
	
КонецПроцедуры

Процедура ТестДолжен_ПрерватьОжидатьЗавершенияПриОтмене() Экспорт
	ПроверитьОтменуОжиданияДругогоЗадания("ОжидатьЗавершения");
КонецПроцедуры

Процедура ТестДолжен_ПрерватьОжидатьВсеПриОтмене() Экспорт
