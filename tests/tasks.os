КонецПроцедуры

Процедура ДержатьБлокировку(Сигнал, Блокировка) Экспорт
	
	Блокировка.Заблокировать();
	Попытка
		Сигнал.Добавить(Истина);
		Пока Истина Цикл
			Приостановить(10);
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ВзятьБлокировку(Сигнал, Блокировка) Экспорт
	Сигнал.Добавить(Истина);
	Блокировка.Заблокировать();
	Блокировка.Разблокировать();
КонецПроцедуры

Процедура ВзятьБлокировкуИУпасть(Сигнал, Блокировка) Экспорт
	Сигнал.Добавить(Истина);
	Блокировка.Заблокировать();
	ВызватьИсключение "Ошибка при захваченной блокировке";
КонецПроцедуры

Процедура ПроверитьЧтоБлокировкаСвободна(Блокировка)
	
	Параметры = Новый Массив;
	Параметры.Добавить(Новый Массив);
	Параметры.Добавить(Блокировка);
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВзятьБлокировку", Параметры);
	Освободилась = Задание.ОжидатьЗавершения(5000);
	Задание.Отменить();
	
	юТест.ПроверитьИстину(Освободилась, "Блокировка должна быть свободна");
	
КонецПроцедуры

Процедура ТестДолжен_ПрерватьОжиданиеБлокировкиПриОтмене() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Держатель = ЗапуститьСоСигналом(ЭтотОбъект, "ДержатьБлокировку", Блокировка);
	Ждущее = ЗапуститьСоСигналом(ЭтотОбъект, "ВзятьБлокировку", Блокировка);
	
	Ждущее.Отменить();
	Остановилось = Ждущее.ОжидатьЗавершения(10000);
	Держатель.Отменить();
	
	юТест.ПроверитьИстину(Остановилось, "Ожидание блокировки должно прерываться отменой");
	ПроверитьЧтоЗаданиеОтменено(Ждущее);
	ПроверитьЧтоЗаданиеОтменено(Держатель);
	
КонецПроцедуры

Процедура ТестДолжен_ОсвободитьБлокировкуОтмененногоЗадания() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Держатель = ЗапуститьСоСигналом(ЭтотОбъект, "ДержатьБлокировку", Блокировка);
	
	Держатель.Отменить();
	ПроверитьЧтоЗаданиеОтменено(Держатель);
	
	ПроверитьЧтоБлокировкаСвободна(Блокировка);
	
КонецПроцедуры

Процедура ТестДолжен_ОсвободитьБлокировкуЗаданияЗавершившегосяСОшибкой() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Задание = ЗапуститьСоСигналом(ЭтотОбъект, "ВзятьБлокировкуИУпасть", Блокировка);
	Задание.ОжидатьЗавершения();
	
	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.ЗавершеноАварийно, Задание.Состояние);
	ПроверитьЧтоБлокировкаСвободна(Блокировка);
	
КонецПроцедуры

Функция ЗапуститьВложенноеИДождатьсяВсехЗадач() Экспорт
	
	Вложенное = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПроцедураБезПараметров");
	ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	
	Результат = Новый Структура;
	Результат.Вставить("СостояниеВложенного", Вложенное.Состояние);
	Результат.Вставить("ТекущееВРеестре", ФоновыеЗадания.ПолучитьТекущее() <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Процедура ТестДолжен_ОжидатьЗавершенияЗадачИзЗаданияНеОжидаяСебя() Экспорт
	
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапуститьВложенноеИДождатьсяВсехЗадач");
	Завершилось = Задание.ОжидатьЗавершения(10000);
	Задание.Отменить();
	
	юТест.ПроверитьИстину(Завершилось, "Задание не должно ждать само себя");
	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Состояние);
	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Задание.Результат.СостояниеВложенного);
	юТест.ПроверитьИстину(Задание.Результат.ТекущееВРеестре, "Текущее задание не должно удаляться из реестра");
	
КонецПроцедуры

Функция ЗаблокироватьСТаймаутом(Сигнал, Параметры) Экспорт
	
	Сигнал.Добавить(Истина);
	Захвачена = Параметры.Блокировка.Заблокировать(Параметры.Таймаут);
	Если Захвачена Тогда
		Параметры.Блокировка.Разблокировать();
	КонецЕсли;
	
	Возврат Захвачена;
	
КонецФункции

Процедура ТестДолжен_ЗахватитьСвободнуюБлокировкуСТаймаутом() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	юТест.ПроверитьИстину(Блокировка.Заблокировать(100));
	Блокировка.Разблокировать();
	
КонецПроцедуры

Процедура ТестДолжен_ВернутьЛожьПоТаймаутуБлокировки() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Держатель = ЗапуститьСоСигналом(ЭтотОбъект, "ДержатьБлокировку", Блокировка);
	
	// В основном потоке ожидание без отмены
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗахваченаВОсновномПотоке = Блокировка.Заблокировать(300);
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	
	// В фоновом задании ожидание с проверкой отмены
	Ждущее = ЗапуститьСоСигналом(ЭтотОбъект, "ЗаблокироватьСТаймаутом",
		Новый Структура("Блокировка, Таймаут", Блокировка, 300));
	Ждущее.ОжидатьЗавершения(5000);
	
	Держатель.Отменить();
	ПроверитьЧтоЗаданиеОтменено(Держатель);
	
	юТест.ПроверитьЛожь(ЗахваченаВОсновномПотоке);
	юТест.ПроверитьБольшеИлиРавно(Прошло, 250, "Ожидание должно длиться не меньше таймаута");
	юТест.ПроверитьРавенство(СостояниеФоновогоЗадания.Завершено, Ждущее.Состояние);
	юТест.ПроверитьРавенство(Ложь, Ждущее.Результат);
	
КонецПроцедуры

Процедура ТестДолжен_ЗахватитьБлокировкуДоИстеченияТаймаута() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Держатель = ЗапуститьСоСигналом(ЭтотОбъект, "ДержатьБлокировку", Блокировка);
	Ждущее = ЗапуститьСоСигналом(ЭтотОбъект, "ЗаблокироватьСТаймаутом",
		Новый Структура("Блокировка, Таймаут", Блокировка, 10000));
	
	Держатель.Отменить();
	
	юТест.ПроверитьИстину(Ждущее.ОжидатьЗавершения(5000), "Ожидающее задание должно получить блокировку");
	юТест.ПроверитьРавенство(Истина, Ждущее.Результат);
	
КонецПроцедуры

Процедура ТестДолжен_ЗапретитьОтрицательныйТаймаутБлокировки() Экспорт
	
	Блокировка = Новый БлокировкаРесурса;
	Попытка
		Блокировка.Заблокировать(-1);
	Исключение
		Возврат;
	КонецПопытки;
	
	ВызватьИсключение "Ожидали исключение на отрицательном таймауте";
	
КонецПроцедуры
