		Текущее = ФоновыеЗадания.ПолучитьТекущее();
		Если Текущее = Неопределено Тогда
			ВызватьИсключение "Не найдено текущее задание";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

