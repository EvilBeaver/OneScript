КонецПроцедуры

Функция ЗагрузитьНативныйМодульДляОтмены()
	
	Текст =
	"#native
	|Процедура ЦиклПока(Сигнал) Экспорт
	|	Сигнал.Добавить(Истина);
	|	Пока Истина Цикл
	|	КонецЦикла;
	|КонецПроцедуры
	|
	|Процедура ЦиклДля(Сигнал) Экспорт
	|	Сигнал.Добавить(Истина);
	|	Для Сч = 1 По 1000000000000 Цикл
	|	КонецЦикла;
	|КонецПроцедуры
	|
	|Процедура ЦиклДляКаждого(Сигнал) Экспорт
	|	Элементы = Новый Массив(1000);
	|	Сигнал.Добавить(Истина);
	|	Для Каждого А Из Элементы Цикл
	|		Для Каждого Б Из Элементы Цикл
	|			Для Каждого В Из Элементы Цикл
	|				Для Каждого Г Из Элементы Цикл
	|				КонецЦикла;
	|			КонецЦикла;
	|		КонецЦикла;
	|	КонецЦикла;
	|КонецПроцедуры
	|
	|Функция Фибоначчи(Н) Экспорт
	|	Если Н < 2 Тогда
	|		Возврат Н;
	|	КонецЕсли;
	|	Возврат Фибоначчи(Н - 1) + Фибоначчи(Н - 2);
	|КонецФункции
	|
	|Процедура Рекурсия(Сигнал) Экспорт
	|	Сигнал.Добавить(Истина);
	|	Фибоначчи(100);
	|КонецПроцедуры
	|
	|Процедура ЦиклВПопытке(Сигнал, Перехват) Экспорт
	|	Сигнал.Добавить(Истина);
	|	Пока Истина Цикл
	|		Попытка
	|			Приостановить(10);
	|		Исключение
	|			Перехват.Добавить(Истина);
	|		КонецПопытки;
	|	КонецЦикла;
	|КонецПроцедуры";
	
	Возврат ЗагрузитьСценарийИзСтроки(Текст);
	
КонецФункции

Функция ЗапуститьСоСигналом(Объект, ИмяМетода, ДополнительныйПараметр = Неопределено)
	
	Сигнал = Новый Массив;
	Параметры = Новый Массив;
	Параметры.Добавить(Сигнал);
	Если ДополнительныйПараметр <> Неопределено Тогда
		Параметры.Добавить(ДополнительныйПараметр);
	КонецЕсли;
	
	Задание = ФоновыеЗадания.Выполнить(Объект, ИмяМетода, Параметры);
	
	Для Итерация = 1 По 1000 Цикл
		Если Сигнал.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;
	юТест.ПроверитьРавенство(1, Сигнал.Количество(), "Фоновое задание не запустилось");
	
	// После сигнала задание переходит к блокирующему вызову, дадим ему туда дойти
	Приостановить(100);
	
	Возврат Задание;
	
КонецФункции

Функция ЗапуститьИОтменитьНативноеЗадание(ИмяМетода, Перехват = Неопределено)
	
	Задание = ЗапуститьСоСигналом(ЗагрузитьНативныйМодульДляОтмены(), ИмяМетода, Перехват);
	Задание.Отменить();
	
	Возврат Задание;
	
КонецФункции

Процедура ТестДолжен_ОтменитьЦиклПокаВНативномМодуле() Экспорт
	
	Задание = ЗапуститьИОтменитьНативноеЗадание("ЦиклПока");
	ПроверитьЧтоЗаданиеОтменено(Задание);
	
КонецПроцедуры

