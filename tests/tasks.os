	Для Номер = 1 По 4 Цикл
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДергатьТекущее", Новый Массив, Истина));
	КонецЦикла;
	
	НаполнитьРеестрЗаданиями();
	ПроверитьОтсутствиеОшибокВЗаданиях(Задания);
	
