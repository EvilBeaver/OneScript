Процедура ДолгаяПустышка() Экспорт
	Приостановить(2000);
КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоОжиданиеНеСтираетНовыеЗадания() Экспорт
	
	Стартовое = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗапуститьОтложенноеЗадание");
	ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	
	ПозднееЗадание = Стартовое.Результат;
	юТест.ПроверитьНеРавенство(Неопределено, ПозднееЗадание);
	
	Оставшиеся = ФоновыеЗадания.ПолучитьФоновыеЗадания();
	юТест.ПроверитьРавенство(1, Оставшиеся.Количество());
	юТест.ПроверитьРавенство(ПозднееЗадание.УникальныйИдентификатор, Оставшиеся[0].УникальныйИдентификатор);
	
	ПозднееЗадание.ОжидатьЗавершения();
	
КонецПроцедуры
