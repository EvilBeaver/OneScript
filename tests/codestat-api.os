///////////////////////////////////////////////////////////////////////
//
// Сбор статистики из исполняемого кода
//
///////////////////////////////////////////////////////////////////////

Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;

	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоСборСтатистикиЕстьВГлобальномКонтексте");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоСборНедоступенБезФлага");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьЧтоНачатьСборБросаетБезФлага");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьСборДоступенИРезультатЗавершения");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПересекающиесяСборы");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПаузуИВосстановление");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьПереходыСостояний");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьИсключениеНулевыхСтрок");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьДампВФайл");

	Возврат ВсеТесты;

КонецФункции

Процедура ТестДолжен_ПроверитьЧтоСборСтатистикиЕстьВГлобальномКонтексте() Экспорт

	юТест.ПроверитьРавенство(Тип("СборСтатистики"), ТипЗнч(СборСтатистики));
	юТест.ПроверитьЛожь(СборСтатистики.СборДоступен());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоСборНедоступенБезФлага() Экспорт

	юТест.ПроверитьЛожь(СборСтатистики.СборДоступен(), "Без -codestat сбор должен быть недоступен");

КонецПроцедуры

Процедура ТестДолжен_ПроверитьЧтоНачатьСборБросаетБезФлага() Экспорт

	Бросило = Ложь;
	Попытка
		СборСтатистики.НачатьСбор();
	Исключение
		Бросило = Истина;
		юТест.ПроверитьИстину(
			СтрНайти(ИнформацияОбОшибке().Описание, "-codestat") > 0,
			"Текст исключения должен упоминать -codestat"
		);
	КонецПопытки;

	юТест.ПроверитьИстину(Бросило, "НачатьСбор без -codestat должен выбрасывать исключение");

КонецПроцедуры

Процедура ТестДолжен_ПроверитьСборДоступенИРезультатЗавершения() Экспорт

	ТекстСкрипта =
	"Процедура ВыполняемыйМетод()
	|	Значение = 1;
	|КонецПроцедуры
	|
	|Процедура НевызываемыйМетод()
	|	Значение = 2;
	|КонецПроцедуры
	|
	|Функция КоличествоХитов(Таблица, ИмяМетода)
	|	Сумма = 0;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Сумма = Сумма + СтрокаТаблицы.Количество;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Сумма;
	|КонецФункции
	|
	|Функция ВсеСтрокиМетодаСНулями(Таблица, ИмяМетода)
	|	Нашли = Ложь;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Нашли = Истина;
	|			Если СтрокаТаблицы.Количество <> 0 Тогда
	|				Возврат Ложь;
	|			КонецЕсли;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Нашли;
	|КонецФункции
	|
	|Если Не СборСтатистики.СборДоступен() Тогда
	|	ВызватьИсключение ""Сбор должен быть доступен"";
	|КонецЕсли;
	|
	|Сбор = СборСтатистики.НачатьСбор();
	|ВыполняемыйМетод();
	|Таблица = Сбор.Завершить();
	|
	|Если ТипЗнч(Таблица) <> Тип(""ТаблицаЗначений"") Тогда
	|	ВызватьИсключение ""Завершить должен вернуть ТаблицаЗначений"";
	|КонецЕсли;
	|
	|Для Каждого ИмяКолонки Из СтрРазделить(""Путь,Метод,НомерСтроки,Количество,Время"", "","") Цикл
	|	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
	|		ВызватьИсключение ""Нет колонки "" + ИмяКолонки;
	|	КонецЕсли;
	|КонецЦикла;
	|
	|Если КоличествоХитов(Таблица, ""ВыполняемыйМетод"") = 0 Тогда
	|	ВызватьИсключение ""В результате должны быть хиты ВыполняемыйМетод"";
	|КонецЕсли;
	|
	|Если Не ВсеСтрокиМетодаСНулями(Таблица, ""НевызываемыйМетод"") Тогда
	|	ВызватьИсключение ""Завершить должен вернуть непройденные строки НевызываемыйМетод с Количество = 0"";
	|КонецЕсли;";

	ПроверитьУспешныйЗапуск(ТекстСкрипта);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьИсключениеНулевыхСтрок() Экспорт

	ТекстСкрипта =
	"Процедура ВыполняемыйМетод()
	|	Значение = 1;
	|КонецПроцедуры
	|
	|Процедура НевызываемыйМетод()
	|	Значение = 2;
	|КонецПроцедуры
	|
	|Функция КоличествоХитов(Таблица, ИмяМетода)
	|	Сумма = 0;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Сумма = Сумма + СтрокаТаблицы.Количество;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Сумма;
	|КонецФункции
	|
	|Функция ЕстьСтрокиМетода(Таблица, ИмяМетода)
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Возврат Истина;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Ложь;
	|КонецФункции
	|
	|Сбор = СборСтатистики.НачатьСбор();
	|ВыполняемыйМетод();
	|Таблица = Сбор.Завершить(Истина);
	|
	|Если КоличествоХитов(Таблица, ""ВыполняемыйМетод"") = 0 Тогда
	|	ВызватьИсключение ""Хиты ВыполняемыйМетод должны остаться"";
	|КонецЕсли;
	|
	|Если ЕстьСтрокиМетода(Таблица, ""НевызываемыйМетод"") Тогда
	|	ВызватьИсключение ""НевызываемыйМетод не должен попасть в таблицу при excludeZeros"";
	|КонецЕсли;
	|
	|Для Каждого СтрокаТаблицы Из Таблица Цикл
	|	Если СтрокаТаблицы.Количество = 0 Тогда
	|		ВызватьИсключение ""В таблице не должно быть строк с Количество = 0"";
	|	КонецЕсли;
	|КонецЦикла;";

	ПроверитьУспешныйЗапуск(ТекстСкрипта);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПересекающиесяСборы() Экспорт

	ТекстСкрипта =
	"Процедура ТолькоА()
	|	Значение = 1;
	|КонецПроцедуры
	|
	|Процедура ОбщийКод()
	|	Значение = 2;
	|КонецПроцедуры
	|
	|Функция КоличествоХитов(Таблица, ИмяМетода)
	|	Сумма = 0;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Сумма = Сумма + СтрокаТаблицы.Количество;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Сумма;
	|КонецФункции
	|
	|Функция ВсеСтрокиМетодаСНулями(Таблица, ИмяМетода)
	|	Нашли = Ложь;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Нашли = Истина;
	|			Если СтрокаТаблицы.Количество <> 0 Тогда
	|				Возврат Ложь;
	|			КонецЕсли;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Нашли;
	|КонецФункции
	|
	|СборА = СборСтатистики.НачатьСбор();
	|ТолькоА();
	|
	|СборБ = СборСтатистики.НачатьСбор();
	|ОбщийКод();
	|
	|ТаблицаБ = СборБ.Завершить();
	|ТолькоА();
	|ТаблицаА = СборА.Завершить();
	|
	|Если КоличествоХитов(ТаблицаА, ""ТолькоА"") = 0 Тогда
	|	ВызватьИсключение ""Сбор А должен содержать ТолькоА"";
	|КонецЕсли;
	|Если Не ВсеСтрокиМетодаСНулями(ТаблицаБ, ""ТолькоА"") Тогда
	|	ВызватьИсключение ""Сбор Б должен содержать непройденные строки ТолькоА с Количество = 0"";
	|КонецЕсли;
	|Если КоличествоХитов(ТаблицаА, ""ОбщийКод"") = 0 Тогда
	|	ВызватьИсключение ""Сбор А должен содержать ОбщийКод"";
	|КонецЕсли;
	|Если КоличествоХитов(ТаблицаБ, ""ОбщийКод"") = 0 Тогда
	|	ВызватьИсключение ""Сбор Б должен содержать ОбщийКод"";
	|КонецЕсли;";

	ПроверитьУспешныйЗапуск(ТекстСкрипта);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПаузуИВосстановление() Экспорт

	ТекстСкрипта =
	"Процедура ДоПаузы()
	|	Значение = 1;
	|КонецПроцедуры
	|
	|Процедура НаПаузе()
	|	Значение = 2;
	|КонецПроцедуры
	|
	|Процедура ПослеПаузы()
	|	Значение = 3;
	|КонецПроцедуры
	|
	|Функция КоличествоХитов(Таблица, ИмяМетода)
	|	Сумма = 0;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Сумма = Сумма + СтрокаТаблицы.Количество;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Сумма;
	|КонецФункции
	|
	|Функция ВсеСтрокиМетодаСНулями(Таблица, ИмяМетода)
	|	Нашли = Ложь;
	|	Для Каждого СтрокаТаблицы Из Таблица Цикл
	|		Если СтрокаТаблицы.Метод = ИмяМетода Тогда
	|			Нашли = Истина;
	|			Если СтрокаТаблицы.Количество <> 0 Тогда
	|				Возврат Ложь;
	|			КонецЕсли;
	|		КонецЕсли;
	|	КонецЦикла;
	|	Возврат Нашли;
	|КонецФункции
	|
	|Сбор = СборСтатистики.НачатьСбор();
	|ДоПаузы();
	|Сбор.Приостановить();
	|НаПаузе();
	|Сбор.Восстановить();
	|ПослеПаузы();
	|Таблица = Сбор.Завершить();
	|
	|Если КоличествоХитов(Таблица, ""ДоПаузы"") = 0 Тогда
	|	ВызватьИсключение ""Должны быть хиты ДоПаузы"";
	|КонецЕсли;
	|Если Не ВсеСтрокиМетодаСНулями(Таблица, ""НаПаузе"") Тогда
	|	ВызватьИсключение ""Завершить должен вернуть строки НаПаузе с Количество = 0"";
	|КонецЕсли;
	|Если КоличествоХитов(Таблица, ""ПослеПаузы"") = 0 Тогда
	|	ВызватьИсключение ""Должны быть хиты ПослеПаузы"";
	|КонецЕсли;";

	ПроверитьУспешныйЗапуск(ТекстСкрипта);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьПереходыСостояний() Экспорт

	ТекстСкрипта =
	"Процедура ОжидатьИсключение(Сборщик, ИмяМетода, Описание)
	|	Бросило = Ложь;
	|	Попытка
	|		Если ИмяМетода = ""Восстановить"" Тогда
	|			Сборщик.Восстановить();
	|		ИначеЕсли ИмяМетода = ""Приостановить"" Тогда
	|			Сборщик.Приостановить();
	|		ИначеЕсли ИмяМетода = ""Завершить"" Тогда
	|			Сборщик.Завершить();
	|		КонецЕсли;
	|	Исключение
	|		Бросило = Истина;
	|		Если СтрНайти(ИнформацияОбОшибке().Описание, ""Неверное состояние"") = 0 Тогда
	|			ВызватьИсключение;
	|		КонецЕсли;
	|	КонецПопытки;
	|	Если Не Бросило Тогда
	|		ВызватьИсключение Описание + "": ожидалось исключение"";
	|	КонецЕсли;
	|КонецПроцедуры
	|
	|Сбор = СборСтатистики.НачатьСбор();
	|ОжидатьИсключение(Сбор, ""Восстановить"", ""Восстановить из Active"");
	|
	|Сбор.Приостановить();
	|ОжидатьИсключение(Сбор, ""Приостановить"", ""Повторная пауза"");
	|
	|Сбор.Восстановить();
	|Таблица = Сбор.Завершить();
	|Если ТипЗнч(Таблица) <> Тип(""ТаблицаЗначений"") Тогда
	|	ВызватьИсключение ""Завершить из Active должен вернуть таблицу"";
	|КонецЕсли;
	|
	|ОжидатьИсключение(Сбор, ""Завершить"", ""Повторный Завершить"");
	|ОжидатьИсключение(Сбор, ""Приостановить"", ""Пауза после Завершить"");
	|ОжидатьИсключение(Сбор, ""Восстановить"", ""Восстановить после Завершить"");
	|
	|СборСПаузы = СборСтатистики.НачатьСбор();
	|СборСПаузы.Приостановить();
	|ТаблицаСПаузы = СборСПаузы.Завершить();
	|Если ТипЗнч(ТаблицаСПаузы) <> Тип(""ТаблицаЗначений"") Тогда
	|	ВызватьИсключение ""Завершить из Paused должен вернуть таблицу"";
	|КонецЕсли;";

	ПроверитьУспешныйЗапуск(ТекстСкрипта);

КонецПроцедуры

Процедура ТестДолжен_ПроверитьДампВФайл() Экспорт

	ИмяФайлаСкрипта = ПолучитьИмяВременногоФайла("os");
	ИмяФайлаСтатистики = ПолучитьИмяВременногоФайла("json");

	Запись = Новый ЗаписьТекста(ИмяФайлаСкрипта, КодировкаТекста.UTF8);
	Запись.Записать("Значение = 1;");
	Запись.Закрыть();

	Попытка
		Результат = ЗапуститьОскрипт("-codestat=" + ИмяФайлаСтатистики + " """ + ИмяФайлаСкрипта + """");
		юТест.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);

		ФайлСтатистики = Новый Файл(ИмяФайлаСтатистики);
		юТест.ПроверитьИстину(ФайлСтатистики.Существует(), "Файл статистики должен быть записан");
		юТест.ПроверитьБольше(ФайлСтатистики.Размер(), 0, "Файл статистики не должен быть пустым");
	Исключение
		УдалитьФайлы(ИмяФайлаСкрипта);
		УдалитьФайлы(ИмяФайлаСтатистики);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ИмяФайлаСкрипта);
	УдалитьФайлы(ИмяФайлаСтатистики);

КонецПроцедуры

Процедура ПроверитьУспешныйЗапуск(Знач ТекстСкрипта)

	ИмяФайлаСкрипта = ПолучитьИмяВременногоФайла("os");
	Запись = Новый ЗаписьТекста(ИмяФайлаСкрипта, КодировкаТекста.UTF8);
	Запись.Записать(ТекстСкрипта);
	Запись.Закрыть();

	Попытка
		Результат = ЗапуститьОскрипт("-codestat """ + ИмяФайлаСкрипта + """");
		юТест.ПроверитьРавенство(0, Результат.КодВозврата, Результат.Вывод);
	Исключение
		УдалитьФайлы(ИмяФайлаСкрипта);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ИмяФайлаСкрипта);

КонецПроцедуры

Функция ЗапуститьОскрипт(Знач Аргументы)

	СтрокаЗапуска = ПутьОСкрипт() + " " + Аргументы;
	Процесс = СоздатьПроцесс(СтрокаЗапуска, , Истина);
	Процесс.Запустить();

	Вывод = "";
	Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Цикл
		Стр = Процесс.ПотокВывода.Прочитать();
		Если Стр <> Неопределено Тогда
			Вывод = Вывод + Стр;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("КодВозврата, Вывод", Процесс.КодВозврата, Вывод);

КонецФункции

Функция ПутьОСкрипт()
	Возврат "dotnet """ + ОбъединитьПути(КаталогПрограммы(), "oscript.dll") + """";
КонецФункции
