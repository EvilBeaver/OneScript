#Использовать "testlib"
#Использовать "customlib"

Перем юТест;
Перем ГотовыеЗадания;

Функция ПолучитьСписокТестов(Знач Тесты) Экспорт
	юТест = Тесты;
	
	Список = Новый Массив;
	Список.Добавить("ТестДолжен_ИспользоватьВстроенныйЗагрузчик");
	Список.Добавить("ТестДолжен_ИспользоватьПользовательскийЗагрузчик");
	Список.Добавить("ТестДолжен_ЗагрузитьБиблиотекуИзНесколькихЗаданийОдновременно");

	Возврат Список;
	
КонецФункции

Процедура ТестДолжен_ИспользоватьВстроенныйЗагрузчик() Экспорт
	
	А = "";
	ОбщиеФункции.Скажи("Привет", А); 
	юТест.ПроверитьРавенство("Привет", А);
	юТест.ПроверитьРавенство(1, ОбщиеФункции.Один());
	
КонецПроцедуры

Процедура ТестДолжен_ИспользоватьПользовательскийЗагрузчик() Экспорт
	
	Супер = Новый СуперТип();
	
	Супер.А = 1;
	юТест.ПроверитьРавенство(1, Супер.А);
	юТест.ПроверитьРавенство("Привет", Супер.Привет());
	
	НекийОбщийМодуль.УстановитьПоСсылке(Супер.А);
	юТест.ПроверитьРавенство(100, Супер.А);

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьБиблиотекуИзНесколькихЗаданийОдновременно() Экспорт

	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "slowlib");
	ГотовыеЗадания = Новый Массив(4);
	Для Индекс = 0 По ГотовыеЗадания.ВГраница() Цикл
		ГотовыеЗадания[Индекс] = Ложь;
	КонецЦикла;

	Задания = Новый Массив;
	Для Индекс = 0 По ГотовыеЗадания.ВГраница() Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Путь);
		Параметры.Добавить(Индекс);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ИспользоватьМедленнуюБиблиотеку", Параметры));
	КонецЦикла;
	ФоновыеЗадания.ОжидатьВсе(Задания);

	Для Каждого Задание Из Задания Цикл
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение Задание.ИнформацияОбОшибке.ПодробноеОписаниеОшибки();
		КонецЕсли;
		юТест.ПроверитьРавенство("Привет", Задание.Результат);
	КонецЦикла;

КонецПроцедуры

Функция ИспользоватьМедленнуюБиблиотеку(Путь, Индекс) Экспорт

	// Все задания начинают подключать библиотеку одновременно
	ГотовыеЗадания[Индекс] = Истина;
	Для Номер = 1 По 500 Цикл
		Если ВсеЗаданияГотовы() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

	Сценарий = ЗагрузитьСценарийИзСтроки(
		"#Использовать """ + Путь + """
		|Функция Привет() Экспорт
		|	Возврат МедленныйМодуль.Привет();
		|КонецФункции");
	Возврат Сценарий.Привет();

КонецФункции

Функция ВсеЗаданияГотовы()

	// По индексу, а не Для Каждого: другие задания в это время пишут в массив
	Для Индекс = 0 По ГотовыеЗадания.ВГраница() Цикл
		Если Не ГотовыеЗадания[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции
