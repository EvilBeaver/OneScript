// Объекты сценариев, созданные до и после подключения компоненты
Каталог = ТекущийСценарий().Каталог;
До = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "script-object.os"));
ПодключитьВнешнююКомпоненту(ОбъединитьПути(Каталог, "..", "component", "Component.dll"));
После = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "script-object.os"));
Сообщить(До.Получить());
Сообщить(После.Получить());
