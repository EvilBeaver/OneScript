// Вложенные Выполнить, компонента подключается внутри Выполнить. На втором круге
// все выражения берутся из кэша, а глобальных контекстов уже больше
Перем ПеременнаяМодуля;
Перем Путь;
Перем Внешний;
Перем Внутренний;
Перем ПослеПодключения;

Функция МетодМодуля()
	Возврат "метод модуля";
КонецФункции

ПеременнаяМодуля = "переменная модуля";
Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "component", "Component.dll");

Внутренний = "Сообщить(СтрШаблон(""%1 / %2 / %3 / %4"",
	|	ПеременнаяМодуля, МетодМодуля(), ЛокальнаяВнешнего, Вычислить(""ЛокальнаяВнешнего + """" / """" + ПеременнаяМодуля"")))";

ПослеПодключения = "Сообщить(СтрШаблон(""%1 / %2 / %3"", ГлобальныйМетодКомпоненты(), ПеременнаяМодуля, ЛокальнаяВнешнего))";

Внешний = "ЛокальнаяВнешнего = ""локальная внешнего"";
	|Выполнить(Внутренний);
	|Если Круг = 1 Тогда
	|	ПодключитьВнешнююКомпоненту(Путь);
	|	Выполнить(ПослеПодключения);
	|КонецЕсли";

Для Круг = 1 По 2 Цикл
	Выполнить(Внешний);
КонецЦикла;

Выполнить("Выполнить(""Сообщить(Вычислить(""""МетодМодуля()"""") + """" / """" + ГлобальныйМетодКомпоненты())"")");
