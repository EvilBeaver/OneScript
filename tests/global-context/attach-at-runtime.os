// Компонента подключается во время работы модуля: до исправления второй Вычислить
// брал свойство компоненты вместо переменной модуля или падал на номере области
Перем ПеременнаяМодуля;

Функция МетодМодуля()
	Возврат "метод модуля";
КонецФункции

ПеременнаяМодуля = "переменная модуля";
Для Сч = 1 По 2 Цикл
	Сообщить(СтрШаблон("%1 / %2 / %3", ПеременнаяМодуля, МетодМодуля(), Вычислить("ПеременнаяМодуля")));
	Если Сч = 1 Тогда
		ПодключитьВнешнююКомпоненту(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "component", "Component.dll"));
	КонецЕсли;
КонецЦикла;
Сообщить(Вычислить("ГлобальныйМетодКомпоненты()"));
Выполнить("Сообщить(МетодМодуля())");
