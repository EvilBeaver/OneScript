Процедура Тест_ДолженВызватьИсключениеДляФорматаMicrosoftБезУниверсальнойДаты() Экспорт

	// Дано
	Формат = ФорматДатыJSON.Microsoft;
	Варианты = ВариантыЗаписиЛокальнойДатыJSON();

