Процедура Тест_ДолженЗаписатьUnixEpochJSON() Экспорт

	// Дано
	ЗначениеДаты = МестноеВремя(Дата("19700101000000"));

	// Когда
	РезультатJavaScript = ЗаписатьДатуJSON(ЗначениеДаты, ФорматДатыJSON.JavaScript, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	РезультатMicrosoft = ЗаписатьДатуJSON(ЗначениеДаты, ФорматДатыJSON.Microsoft, ВариантЗаписиДатыJSON.УниверсальнаяДата);

	// Тогда
	юТест.ПроверитьРавенство("new Date(0)", РезультатJavaScript);
	юТест.ПроверитьРавенство("/Date(0)/", РезультатMicrosoft);

КонецПроцедуры

Процедура Тест_ДолженЗаписатьМинимальнуюДатуJSONКакВ1С() Экспорт

	// Дано
	МинимальнаяДата = Дата(1, 1, 1, 0, 0, 0);

	// Когда
	РезультатISOКакЛокальнаяДата = ЗаписатьДатуJSON(
		МинимальнаяДата, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата);
	РезультатISOСоСмещением = ЗаписатьДатуJSON(
		МинимальнаяДата, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	РезультатISOКакУниверсальнаяДата = ЗаписатьДатуJSON(
		МинимальнаяДата, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	РезультатJavaScript = ЗаписатьДатуJSON(
		МинимальнаяДата, ФорматДатыJSON.JavaScript, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	РезультатMicrosoft = ЗаписатьДатуJSON(
		МинимальнаяДата, ФорматДатыJSON.Microsoft, ВариантЗаписиДатыJSON.УниверсальнаяДата);

	// Тогда
	юТест.ПроверитьРавенство("0001-01-01T00:00:00", РезультатISOКакЛокальнаяДата);
	юТест.ПроверитьРавенство("0001-01-01T00:00:00+00:00", РезультатISOСоСмещением);
	юТест.ПроверитьРавенство("0001-01-01T00:00:00Z", РезультатISOКакУниверсальнаяДата);
	юТест.ПроверитьРавенство("new Date(-62135596800000)", РезультатJavaScript);
	юТест.ПроверитьРавенство("/Date(-62135596800000)/", РезультатMicrosoft);

КонецПроцедуры

Процедура Тест_ДолженЗаписатьДатыРядомСМинимальнойJSON() Экспорт

	// Дано
	ДатаСОднойСекундой = Дата(1, 1, 1, 0, 0, 1);
	ДатаСОднимЧасом = Дата(1, 1, 1, 1, 0, 0);
	ДатаСТремяЧасами = Дата(1, 1, 1, 3, 0, 0);
	СмещениеОколоМинимальнойДаты = СмещениеТекущейЗоныДляДаты(Дата(1, 1, 2, 0, 0, 0));

	// Когда
	ЛокальнаяДатаСОднойСекундой = ЗаписатьДатуJSON(
		ДатаСОднойСекундой, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата);
	ЛокальнаяДатаСОднимЧасом = ЗаписатьДатуJSON(
		ДатаСОднимЧасом, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата);
	ЛокальнаяДатаСТремяЧасами = ЗаписатьДатуJSON(
		ДатаСТремяЧасами, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата);
	ДатаСоСмещениемСОднойСекундой = ЗаписатьДатуJSON(
		ДатаСОднойСекундой, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	ДатаСоСмещениемСОднимЧасом = ЗаписатьДатуJSON(
		ДатаСОднимЧасом, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	ДатаСоСмещениемСТремяЧасами = ЗаписатьДатуJSON(
		ДатаСТремяЧасами, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	УниверсальнаяДатаСОднойСекундой = ЗаписатьДатуJSON(
		ДатаСОднойСекундой, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	УниверсальнаяДатаСОднимЧасом = ЗаписатьДатуJSON(
		ДатаСОднимЧасом, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);
	УниверсальнаяДатаСТремяЧасами = ЗаписатьДатуJSON(
		ДатаСТремяЧасами, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);

	// Тогда
	юТест.ПроверитьРавенство("0001-01-01T00:00:01", ЛокальнаяДатаСОднойСекундой);
	юТест.ПроверитьРавенство("0001-01-01T01:00:00", ЛокальнаяДатаСОднимЧасом);
	юТест.ПроверитьРавенство("0001-01-01T03:00:00", ЛокальнаяДатаСТремяЧасами);
	юТест.ПроверитьРавенство("0001-01-01T00:00:01" + СмещениеОколоМинимальнойДаты,
		ДатаСоСмещениемСОднойСекундой);
	юТест.ПроверитьРавенство("0001-01-01T01:00:00" + СмещениеОколоМинимальнойДаты,
		ДатаСоСмещениемСОднимЧасом);
	юТест.ПроверитьРавенство("0001-01-01T03:00:00" + СмещениеОколоМинимальнойДаты,
		ДатаСоСмещениемСТремяЧасами);
	юТест.ПроверитьРавенство(ФорматISO(УниверсальноеВремя(ДатаСОднойСекундой)) + "Z",
		УниверсальнаяДатаСОднойСекундой);
	юТест.ПроверитьРавенство(ФорматISO(УниверсальноеВремя(ДатаСОднимЧасом)) + "Z",
		УниверсальнаяДатаСОднимЧасом);
	юТест.ПроверитьРавенство(ФорматISO(УниверсальноеВремя(ДатаСТремяЧасами)) + "Z",
		УниверсальнаяДатаСТремяЧасами);

КонецПроцедуры

Процедура Тест_ДолженЗаписатьМаксимальнуюДатуJSONКакВ1С() Экспорт

	// Дано
	МаксимальнаяДата = Дата(3999, 12, 31, 23, 59, 59);
	ОжидаемаяДатаUTC = УниверсальноеВремя(МаксимальнаяДата);

	// Когда
	Результат = ЗаписатьДатуJSON(МаксимальнаяДата, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);

	// Тогда
	юТест.ПроверитьРавенство(ФорматISO(ОжидаемаяДатаUTC) + "Z", Результат);

КонецПроцедуры

Процедура Тест_ДолженВызватьИсключениеЕслиДатаИмеетНеверныйТип() Экспорт

	// Дано
	Значения = Новый Массив;
	Значения.Добавить("20140510131415");
	Значения.Добавить(1);
	Значения.Добавить(Истина);
	Значения.Добавить(Неопределено);
	Значения.Добавить(Null);
	Значения.Добавить(Новый Массив);
	Значения.Добавить(Новый Структура);

	// Когда
	ОписанияОшибок = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Попытка
			ЗаписатьДатуJSON(Значение, ФорматДатыJSON.ISO);
		Исключение
			ОписанияОшибок.Добавить(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		ВызватьИсключение "Для первого параметра недопустимого типа должно быть вызвано исключение";
	КонецЦикла;

	// Тогда
	ПроверитьОписанияОшибокСодержат(ОписанияОшибок, "Неверный тип аргумента номер 1");

КонецПроцедуры

Процедура Тест_ДолженВызватьИсключениеЕслиФорматИмеетНеверныйТип() Экспорт

	// Дано
	Значения = ЗначенияНеприводимыеКПеречислению();

	// Когда
	ОписанияОшибок = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Попытка
			ЗаписатьДатуJSON(Дата("20140510131415"), Значение);
		Исключение
			ОписанияОшибок.Добавить(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		ВызватьИсключение "Для второго параметра недопустимого типа должно быть вызвано исключение";
	КонецЦикла;

	// Тогда
	ПроверитьОписанияОшибокСодержат(ОписанияОшибок, "Неверный тип аргумента");

КонецПроцедуры

