#Использовать asserts

Перем юТест;

Функция ПолучитьСписокТестов(Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеISOКакЛокальнуюДатуПоУмолчанию");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеISOКакЯвнуюЛокальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеISOКакЛокальнуюДатуСоСмещением");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеISOКакУниверсальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеJavaScriptКакУниверсальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьОбычнуюДатуJSONВФорматеJavaScriptКакУниверсальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатуJSONВФорматеMicrosoftКакУниверсальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьОбычнуюДатуJSONВФорматеMicrosoftКакУниверсальнуюДату");
	СписокТестов.Добавить("Тест_ДолженЗаписатьUnixEpochJSON");
	СписокТестов.Добавить("Тест_ДолженЗаписатьМинимальнуюДатуJSONКакВ1С");
	СписокТестов.Добавить("Тест_ДолженЗаписатьДатыРядомСМинимальнойJSON");
	СписокТестов.Добавить("Тест_ДолженЗаписатьМаксимальнуюДатуJSONКакВ1С");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеЕслиДатаИмеетНеверныйТип");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеЕслиФорматИмеетНеверныйТип");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеЕслиВариантЗаписиИмеетНеверныйТип");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеДляФорматаJavaScriptПоУмолчанию");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеДляФорматаJavaScriptБезУниверсальнойДаты");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеДляФорматаMicrosoftПоУмолчанию");
	СписокТестов.Добавить("Тест_ДолженВызватьИсключениеДляФорматаMicrosoftБезУниверсальнойДаты");

	Возврат СписокТестов;

КонецФункции

Процедура Тест_ДолженЗаписатьДатуJSONВФорматеISOКакЛокальнуюДатуПоУмолчанию() Экспорт

	// Дано
	ЗначениеДаты = Дата("20140510131415");

	// Когда
	Результат = ЗаписатьДатуJSON(ЗначениеДаты, ФорматДатыJSON.ISO);

	// Тогда
	юТест.ПроверитьРавенство("2014-05-10T13:14:15", Результат);

КонецПроцедуры

