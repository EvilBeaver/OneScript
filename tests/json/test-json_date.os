КонецПроцедуры

Функция ФорматISO(Дата)
	Если Дата = Дата(1, 1, 1, 0, 0, 0) Тогда
		Возврат "0001-01-01T00:00:00";
	КонецЕсли;

	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция СмещениеТекущейЗоныДляДаты(Дата)
	СмещениеВСекундах = Дата - УниверсальноеВремя(Дата);
	Знак = ?(СмещениеВСекундах < 0, "-", "+");
	ВсегоСекунд = ?(СмещениеВСекундах < 0, -СмещениеВСекундах, СмещениеВСекундах);
	Часы = Цел(ВсегоСекунд / 3600);
	Минуты = Цел((ВсегоСекунд - Часы * 3600) / 60);
	ЧасыСтрокой = Формат(Часы, "ЧГ=0; ЧН=0");
	МинутыСтрокой = Формат(Минуты, "ЧГ=0; ЧН=0");

	Если СтрДлина(ЧасыСтрокой) = 1 Тогда
		ЧасыСтрокой = "0" + ЧасыСтрокой;
	КонецЕсли;

	Если СтрДлина(МинутыСтрокой) = 1 Тогда
		МинутыСтрокой = "0" + МинутыСтрокой;
	КонецЕсли;

	Возврат Знак + ЧасыСтрокой + ":" + МинутыСтрокой;
КонецФункции

Функция ЗначенияНеприводимыеКПеречислению()
	Значения = Новый Массив;
	Значения.Добавить(Дата("20140510131415"));
	Значения.Добавить(Новый Массив);
	Значения.Добавить(Новый Структура);
	Возврат Значения;
КонецФункции

Функция ВариантыЗаписиЛокальнойДатыJSON()
	Варианты = Новый Массив;
	Варианты.Добавить(ВариантЗаписиДатыJSON.ЛокальнаяДата);
	Варианты.Добавить(ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	Возврат Варианты;
КонецФункции

Функция ОписанияИсключенийЗаписиДатыJSON(Формат, Варианты)
	ОписанияОшибок = Новый Массив;
	Для Каждого Вариант Из Варианты Цикл
		ОписанияОшибок.Добавить(ОписаниеИсключенияЗаписиДатыJSON(Формат, Вариант));
	КонецЦикла;
	Возврат ОписанияОшибок;
КонецФункции

Функция ОписаниеИсключенияЗаписиДатыJSON(Формат, Вариант = Неопределено)
	Попытка
		Если Вариант = Неопределено Тогда
			ЗаписатьДатуJSON(Дата("20140510131415"), Формат);
		Иначе
			ЗаписатьДатуJSON(Дата("20140510131415"), Формат, Вариант);
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	ВызватьИсключение "Для указанного формата и варианта записи даты должно быть вызвано исключение";
КонецФункции

Процедура ПроверитьОписанияОшибокСодержат(ОписанияОшибок, ТекстОшибки)

	Для Каждого ОписаниеОшибки Из ОписанияОшибок Цикл
		юТест.ПроверитьВхождение(ОписаниеОшибки, ТекстОшибки);
	КонецЦикла;

КонецПроцедуры
