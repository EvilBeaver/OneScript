Пока Истина Цикл

	Нажатие = Консоль.ПрочитатьНажатие(); 

	Сообщить("Код кнопки: " + Нажатие.КодКнопки);

	Если Нажатие.Модификаторы.Control Тогда
		Сообщить("Ctrl + " + Нажатие.Символ);
	ИначеЕсли Нажатие.Модификаторы.Shift Тогда
		Сообщить("Shift + " + Нажатие.Символ);
	ИначеЕсли Нажатие.Модификаторы.Alt Тогда
		Сообщить("Alt + " + Нажатие.Символ);
	Иначе
		Сообщить(Нажатие.Символ);
	КонецЕсли;

	Если Нажатие.КодКнопки = 27 Тогда   // Escape
		Сообщить("Выход");
		Прервать;
	КонецЕсли;

КонецЦикла;